/* ════ 可自由调整的虚构参数 ════ */
var DISTANCE_KM='12.6';var AVT=Date.now();function setDistTxt(){var hrs=(LISTEN_SECONDS/3600).toFixed(1);var t='相距 '+DISTANCE_KM+'公里，一起听了'+hrs+'小时';var d=$('distance');if(d&&!window._nkRoomOn)d.textContent=t;var s=$('cvsub');if(s)s.textContent='相距'+DISTANCE_KM+'公里，一起听了'+hrs+'小时'}
var LISTEN_SECONDS=0;
function $(id){return document.getElementById(id)}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'"',"'":'&#39;'}[c]})}
function fmt(ms){if(!ms||ms<0||!isFinite(ms))return'00:00';var s=Math.floor(ms/1000),m=Math.floor(s/60);s=s%60;return(m<10?'0':'')+m+':'+(s<10?'0':'')+s}
function toast(t){var el=$('toast');el.textContent=t;el.classList.add('show');clearTimeout(el._t);el._t=setTimeout(function(){el.classList.remove('show')},1800)}
function api(p,b){return fetch(p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b||{})}).then(function(r){return r.json()}).catch(function(){return null})}
setDistTxt();
/* P5: 网易云账号头像 —— 接入AI陪听后拉取并展示(代理走 /avatar/netease 绕防盗链) */
function setAvUrl(id,cvId,url){var el=$(id);if(el){el.textContent='';el.style.backgroundImage="url('"+url+"')"}var cv=$(cvId);if(cv){cv.textContent='';cv.style.backgroundImage="url('"+url+"')"}}
function applyNativeAccount(acc,accounts){accounts=accounts||window._nkAccounts||{};var ai=accounts.ai||acc;var hu=accounts.human;if(ai&&ai.avatarUrl){setAvUrl('avby','cvby','/avatar/netease?u='+encodeURIComponent(ai.avatarUrl)+'&t='+Date.now())}if(hu&&hu.avatarUrl){setAvUrl('avme','cvme','/avatar/netease?u='+encodeURIComponent(hu.avatarUrl)+'&t='+Date.now())}if(acc)window._nkAccount=acc;window._nkAccounts=accounts}
function refreshNativeAvatar(){return fetch('/mode').then(function(r){return r.json()}).then(function(j){var n=(j&&j.native)||{};var acc=n.account||(j&&j.nativeAccount);var accounts=n.accounts||(j&&j.nativeAccounts);if(acc||accounts)applyNativeAccount(acc,accounts);return acc||accounts}).catch(function(){return null})}
/* P6: 实时房间快照展示 —— 有 2 人且已连接 → 顶部"正在一起听"提示 */
function applyNativeRoom(nr){
  if(!nr)return;
  var d=$('distance');if(!d)return;
  var cnt=(nr.remoteUsers||[]).length;
  if(nr.connected&&cnt>=2){
    window._nkRoomOn=true;
    var names=(nr.remoteUsers||[]).map(function(u){return u.nickname||('用户'+u.userId)}).join(' × ');
    d.textContent='已同房 '+cnt+' 人：'+names;
  }else if(nr.connected){
    window._nkRoomOn=false;
    if(window._nkInviteSent)window._nkInviteSent=false;
    setDistTxt();
  }
}
/* 头像: 探测/avatar/has决定替换emoji(优先级: 自定义上传>Operit同步>兜底🌙🌸) */
(function(){
  function setAv(id,w){$(id).textContent='';$(id).style.backgroundImage="url('/avatar/"+w+"?t="+Date.now()+"')";var cv=$(w==='me'?'cvme':'cvby');if(cv){cv.textContent='';cv.style.backgroundImage="url('/avatar/"+w+"?t="+Date.now()+"')"}}
  api('/avatar/has').then(function(h){
    if(!h)return;
    if(h.me)setAv('avme','me');
    if(h.by)setAv('avby','by');
  });
  /* 点头像换头像(me=用户/by=好友): 系统选图器→Canvas中心方形裁剪256px JPEG→/avatar/set 持久化 */
  var inp=document.createElement('input');inp.type='file';inp.accept='image/*';inp.style.display='none';document.body.appendChild(inp);
  var curWho='me';
  $('avme').addEventListener('click',function(e){e.stopPropagation();curWho='me';inp.click()});
  $('avby').addEventListener('click',function(e){e.stopPropagation();curWho='by';inp.click()});
  inp.addEventListener('change',function(){
    var f=inp.files&&inp.files[0];inp.value='';if(!f)return;
    var rd=new FileReader();
    rd.onload=function(){var img=new Image();
      img.onload=function(){
        try{
          var w=img.naturalWidth,h=img.naturalHeight,s=Math.min(w,h),c=document.createElement('canvas');
          c.width=c.height=256;
          c.getContext('2d').drawImage(img,(w-s)/2,(h-s)/2,s,s,0,0,256,256);
          var du=c.toDataURL('image/jpeg',0.82);
          api('/avatar/set',{dataUrl:du,who:curWho}).then(function(r){
            if(r&&r.ok){setAv(curWho==='me'?'avme':'avby',curWho);toast('头像换好啦～')}
            else toast('保存失败：'+((r&&r.error)||'未知错误'))
          });
        }catch(e){toast('图片处理失败')}
      };
      img.onerror=function(){toast('图片读取失败')};
      img.src=rd.result};
    rd.readAsDataURL(f)});
})();
var S={song:null,playing:false,members:[],unread:0,playlist:[],favorites:[],favoritesSeq:0,playMode:'order'};
var clientId=null;try{clientId=localStorage.getItem('lt_cid')}catch(e){}
if(!clientId){clientId='web_'+Date.now().toString(36)+Math.random().toString(36).slice(2,7);try{localStorage.setItem('lt_cid',clientId)}catch(e){}}
var audio=$('audio'),seeking=false;
/* ── 歌词面板: 点唱片切换, 当前句居中滚动, 手动滑动暂停3.5s, 点句跳播 ── */
var lyrMode=false,lyrUser=0,lyrEls=[],lyrTy=0;
function applyTy(ty){lyrTy=ty;var sc=$('lyrscroll');sc.style.webkitTransform='translateY('+ty+'px)';sc.style.transform='translateY('+ty+'px)'}
/* 滑动边界: 首句居中=上限, 末句居中=下限, 越界禁止 */
function lyrBound(){var v=$('lyrview'),n=lyrEls.length;if(!n)return[0,0];return[v.clientHeight/2-lyrEls[n-1].offsetTop-lyrEls[n-1].offsetHeight/2,v.clientHeight/2-lyrEls[0].offsetTop-lyrEls[0].offsetHeight/2]}
function buildLyrics(){
  var sc=$('lyrscroll');sc.innerHTML='';lyrEls=[];
  for(var i=0;i<curLyrics.length;i++){
    var d=document.createElement('div');d.className='lrl';
    var tx=document.createElement('span');tx.className='lptx';tx.textContent=curLyrics[i].x;
    (function(idx){tx.addEventListener('click',function(e){e.stopPropagation();setLyr(false)})})(i);
    d.appendChild(tx);
    sc.appendChild(d);lyrEls.push(d);
  }
}
/* 浏览态: 滑动时计算屏幕中央的歌词句, 显示在底部横条, 点播放键跳转 */
var lyrBrowseIdx=-1;
function lyrCenterIdx(){
  var v=$('lyrview'),c=v.clientHeight/2-lyrTy,best=-1,bd=1e9;
  for(var i=0;i<lyrEls.length;i++){
    var el=lyrEls[i],mid=el.offsetTop+el.offsetHeight/2,d=Math.abs(mid-c);
    if(d<bd){bd=d;best=i}
  }
  return best;
}
function lyrHintShow(){
  var i=lyrCenterIdx();
  if(i<0)return;
  lyrBrowseIdx=i;
  $('lyrhinttx').textContent=fmt(curLyrics[i].t*1000);
  $('lyrhint').style.display='-webkit-flex';$('lyrhint').style.display='flex';
}
function lyrHintHide(){$('lyrhint').style.display='none';lyrBrowseIdx=-1}
$('lyrhintbtn').addEventListener('click',function(e){
  e.stopPropagation();
  if(lyrBrowseIdx<0)return;
  var du=audio.duration||1;
  seekTo(Math.min(.999,Math.max(0,curLyrics[lyrBrowseIdx].t/du)));
  lyrUser=0;lyrHintHide();
});
function lyrScrollTo(i,force){
  if(!lyrEls.length||i<0)return;
  if(!force&&Date.now()<lyrUser)return;
  $('lyrview').classList.remove('browsing');
  var el=lyrEls[i],v=$('lyrview'),b=lyrBound();
  applyTy(Math.max(b[0],Math.min(b[1],v.clientHeight/2-el.offsetTop-el.offsetHeight/2)));
}
function hlLrc(i){
  for(var k=0;k<lyrEls.length;k++)lyrEls[k].className=k===i?'lrl cur':'lrl';
  if(i>=0)lyrScrollTo(i,false);
}
function setLyr(m){
  lyrMode=m;
  $('vinylwrap').className=m?'vpop off':'vpop';
  $('songrow').style.display=m?'none':'';
  $('lyrview').className=m?'on':'';
  $('lyricline').style.visibility=m?'hidden':'';
  if(!m)lyrHintHide();
  if(m)lyrScrollTo(Math.max(0,curLine),true);
}
$('vinylwrap').addEventListener('click',function(){setLyr(!lyrMode)});
/* 官方式手动滑碟切歌: 左滑下一首右滑上一首, 跟手拖动未达阈值回弹 */
(function(){
 var vw=$('vinylwrap'),x0=0,y0=0,dx=0,on=false,_nbL=null,_nbR=null,_pend=false,_raf=0,_lx=0,_lt=0,_lv=0;
 function clr(vb){['webkitTransition','transition','webkitTransform','transform','opacity','willChange'].forEach(function(k){try{vb.style[k]=''}catch(e){}})}
 function nbKill(){if(_nbL&&_nbL.parentNode)_nbL.parentNode.removeChild(_nbL);if(_nbR&&_nbR.parentNode)_nbR.parentNode.removeChild(_nbR);_nbL=_nbR=null}
 function nbInit(){ /* 邻居碟: 克隆主碟(保留id继承全部样式), 封面取列表上/下一首, 左右各一 */
  var vb=$('vinylbox');if(!vb)return;
  nbKill();
  var pl=S.playlist||[],cur=(S.song&&S.song.id!=null)?String(S.song.id):null,ci=-1,i;
  for(i=0;i<pl.length;i++){if(String(pl[i].id)===cur){ci=i;break}}
  if(ci<0||pl.length<2)return;
  function mk(side){
   var n=((ci+side)%pl.length+pl.length)%pl.length,g=pl[n];
   var c=vb.cloneNode(true);c.style.cssText+=';z-index:5;pointer-events:none;opacity:0;will-change:transform';
   var vv=c.querySelector('#vinyl');var _ga=0;try{var _gm=new DOMMatrixReadOnly(getComputedStyle(vv).transform==='none'?'':getComputedStyle(vv).transform);_ga=Math.atan2(_gm.m12,_gm.m11)*180/Math.PI;if(!isFinite(_ga))_ga=0}catch(e){} try{vv.style.webkitAnimation='none';vv.style.animation='none';vv.style.webkitTransform=vv.style.transform='rotate('+_ga.toFixed(2)+'deg)'}catch(e){} /* 克隆碟静态定帧: 无动画层不叠合成层, 杜绝拖动鬼影; 角度烘焙供相位锁定读取 */
   var im=c.querySelector('#cover');if(im&&g&&g.pic)im.src=g.pic;
   vw.appendChild(c);return c;
  }
