var lastSeq=-1;
function applySync(st){
 if(!st)return;
 if(st.seq&&st.seq===lastSeq)return;lastSeq=st.seq||0;
 var wasId=S.song?String(S.song.id):null;
  S.song=st.song;S.playing=!!st.playing;_shouldPlay=!!st.playing;S.members=st.members||[];
 if(Array.isArray(st.playlist)){S.playlist=st.playlist;if(plTab==='list'&&$('plpanel').classList.contains('open'))renderPlaylist()}
 if(Array.isArray(st.favorites)){S.favorites=st.favorites;if(plTab==='fav'&&$('plpanel').classList.contains('open'))renderFavorites()}
 updateLikeBtn();
 if(typeof st.playMode==='string'&&st.playMode!==S.playMode){S.playMode=st.playMode;applyModeUI(st.playMode)}
 if(st.meta){if(typeof st.meta.distanceKm==='string')DISTANCE_KM=st.meta.distanceKm;if(typeof st.meta.listenSeconds==='number')LISTEN_SECONDS=st.meta.listenSeconds;setDistTxt()}
   if(st.nativeAccount||st.nativeAccounts)applyNativeAccount(st.nativeAccount,st.nativeAccounts);
   /* P6: 实时房间快照 → 展示"两人已同房" */
   if(st.nativeRoom)applyNativeRoom(st.nativeRoom);
 if(S.song){
  var sameSong=wasId===String(S.song.id);
  if(!sameSong){loadSong(S.song,S.playing,st.positionMs||0);setPlayingUI(S.playing)}
  else{
   var sp=st.positionMs||0;
   /* URL 刷新: 同一首歌但 URL 变了, 更新 audio.src 并从当前位置继续 */
   /* 仅在前台时热切换, 后台时不换 src 以免中断播放 */
   if(!document.hidden && S.song.url && S.song.url !== audio.src && audio.src){
    var keepMs = audio.currentTime ? audio.currentTime * 1000 : sp;
    audio.src = S.song.url;
    audio._resumeMs = keepMs;
    audio.addEventListener('loadedmetadata',function once(){audio.removeEventListener('loadedmetadata',once);try{audio.currentTime=keepMs/1000}catch(e){}});
   }
   /* 仅在本地正在播时做漂移校正(>1.8s); 暂停态不动currentTime以免打架 */
   if(!seeking&&S.playing&&!audio.paused&&Math.abs(audio.currentTime*1000-sp)>1800)try{audio.currentTime=sp/1000}catch(e){}
