 $('cvartist').textContent=song.artist||'';
 $('cvvip').style.display='';
  if(song.pic && !window._customBgActive)$('cvbg').style.backgroundImage='url("'+song.pic+'")';
  if($('commentpanel').classList.contains('open'))loadHotComments(song.id,song.qq_songid);
   if(song.pic){$('cover').src=song.pic;$('cover').style.visibility='visible';if(!window._customBgActive)swapBg($('bg'),song.pic)}
   else{$('cover').style.visibility='hidden';if(!window._customBgActive)swapBg($('bg'),null)}
 audio.src=song.url;curLyrics=[];curLine=-1;$('lyricline').textContent='';buildLyrics();
 /* 续播位置: 元数据加载完成后seek(直接设currentTime会因src刚换而失效) */
 audio._resumeMs=startMs||0;
 if(audio._resumeMs>0)audio.addEventListener('loadedmetadata',function once(){audio.removeEventListener('loadedmetadata',once);try{audio.currentTime=audio._resumeMs/1000}catch(e){}audio._resumeMs=0});
 $('durtime').textContent=song.duration?fmt(song.duration):'00:00';
 $('curtime').textContent='00:00';updateBar(0);
 /* 官方k4.smali: 封面初始角度 Random(0..360), 负delay实现, 20s一圈 */
 var v=$('vinyl');
  var _pa=0;try{var _pm=new DOMMatrixReadOnly(getComputedStyle(v).transform==="none"?"":getComputedStyle(v).transform);_pa=Math.atan2(_pm.m12,_pm.m11)*180/Math.PI;if(!isFinite(_pa))_pa=0;if(_pa<0)_pa+=360}catch(e){}
  try{if(typeof _fresh!=='undefined'&&_fresh&&_vw&&_vw._nbAngle&&(Date.now()-_mslid)<900){var _na=_vw._nbAngle();if(isFinite(_na)&&_na>=0)_pa=_na;}}catch(e){}
 try{v.style.webkitAnimation='none'}catch(e){}
 v.style.animation='none';void v.offsetWidth;
  var ph=_pa>0.5?-((_pa/360)*20).toFixed(3):-(Math.random()*20).toFixed(3);
 v.style.animation='spin 20s linear infinite paused';
 v.style.animationDelay=ph+'s';
 v.style.animationPlayState=S.playing?'running':'paused';
 fetch('/api/lyric?id='+song.id).then(function(r){return r.json()}).then(function(d){parseLrc((d&&d.lrc&&d.lrc.lyric)||'')}).catch(function(){});
 updateMediaMeta(song);
 if(autoplay)ensurePlay();
}
function parseLrc(lrc){if(!lrc)return;var re=/\[(\d+):(\d+(?:\.\d+)?)\]([^\[\]\n]*)/g,m,out=[];while((m=re.exec(lrc))){var t=(+m[1])*60+(+m[2]);if(m[3].trim())out.push({t:t,x:m[3].trim()})}out.sort(function(a,b){return a.t-b.t});curLyrics=out;buildLyrics()}
function setPlayingUI(p){
 $('playsvg').innerHTML=p?'<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>':'<path d="M8 5v14l11-7z"/>';
 var v=$('vinyl');v.classList.toggle('playing',p);
 try{v.style.webkitAnimationPlayState=p?'running':'paused'}catch(e){}
 v.style.animationPlayState=p?'running':'paused';
 updateMediaSession(p);
}
function updateBar(ratio){ratio=Math.max(0,Math.min(1,ratio||0));bar._last=ratio;$('barfill').style.width=(ratio*100)+'%';$('barthumb').style.left='calc('+(ratio*100)+'% - 6px)'}
audio.addEventListener('timeupdate',function(){
 var cur=audio.currentTime*1000,dur=(audio.duration||0)*1000||(S.song&&S.song.duration)||0;
 $('curtime').textContent=fmt(cur);
 if(dur>0&&!seeking)updateBar(cur/dur);
 if(curLyrics.length){
  var t=cur/1000,i,found=-1;
  for(i=0;i<curLyrics.length;i++){if(curLyrics[i].t<=t)found=i;else break}
  if(found!==curLine){curLine=found;hlLrc(found)}
 }
});
audio.addEventListener('error',function(){if(audio.src)pushControl({action:'refreshurl'})}); // 播放出错→向服务端要新音源
audio.addEventListener('ended',function(){pushControl({action:'next',auto:true})});
audio.addEventListener('loadedmetadata',function(){if(audio.duration)$('durtime').textContent=fmt(audio.duration*1000)});
var bar=$('bar');
function posFrom(ev){
 var t=(ev.touches&&ev.touches[0])||(ev.changedTouches&&ev.changedTouches[0]);
 var cx=t?t.clientX:ev.clientX;
 if(typeof cx!=='number'||!isFinite(cx))return null; /* touchend时坐标已消失 */
 var r=bar.getBoundingClientRect();
 return Math.max(0,Math.min(1,(cx-r.left)/r.width));
}
function seekTo(r){var dur=(audio.duration||(S.song&&S.song.duration/1000)||0);if(dur){try{audio.currentTime=r*dur}catch(e){}pushControl({action:'seek',position:Math.round(r*dur*1000)})}}
bar.addEventListener('touchstart',function(e){e.preventDefault();seeking=true;updateBar(posFrom(e)||0)});
bar.addEventListener('touchmove',function(e){e.preventDefault();updateBar(posFrom(e)||0)});
bar.addEventListener('touchend',function(e){var r=posFrom(e);if(r!=null){updateBar(r);seekTo(r)}else if(seeking)updateBar(bar._last||0);seeking=false});
bar.addEventListener('mousedown',function(e){seeking=true;updateBar(posFrom(e))});
document.addEventListener('mousemove',function(e){if(seeking)updateBar(posFrom(e))});
document.addEventListener('mouseup',function(e){if(seeking){seekTo(posFrom(e));seeking=false}});
function pushControl(b){b.clientId=clientId;b.by='用户';return api('/control',b)}
$('playbtn').onclick=function(){pushControl({action:'toggle'})};
$('nextbtn').onclick=function(){pushControl({action:'next'}).then(function(ok){if(!ok)toast('房间只有我们俩呀，让好友点首新的吧')})};
$('prevbtn').onclick=function(){if(audio.currentTime>3){seekTo(0)}else{pushControl({action:'prev'}).then(function(ok){if(!ok)toast('没有上一首啦')})}};
var MODES=['order','one','random'],MODE_TIP={order:'顺序播放',one:'单曲循环',random:'随机播放'};
function applyModeUI(m){
 var one=m==='one',rnd=m==='random';
 $('mloop').style.display=rnd?'none':'';
 $('mrand').style.display=rnd?'':'none';
 $('modeone').style.display=one?'block':'none';
 var b=$('modebtn');b.classList.toggle('one',one);b.classList.toggle('random',rnd);
}
applyModeUI(S.playMode);
$('modebtn').onclick=function(){
 var m=MODES[(MODES.indexOf(S.playMode)+1)%MODES.length];
 applyModeUI(m);S.playMode=m;toast(MODE_TIP[m]);
 pushControl({action:'setmode',mode:m});
};
var commentSeq=0;
 function closeComments(){var m=$('commentmask');if(m)m.classList.remove('open');$('commentpanel').classList.remove('open')}
 function openComments(){var song=S.song;if(!song||song.id==null){return toast('当前还没有歌曲')};$('commentpanel').classList.add('open');var m=$('commentmask');if(m)m.classList.add('open');loadHotComments(song.id,song.qq_songid)}
 function loadHotComments(id,qqSongId){var seq=++commentSeq,box=$('commentbody');box.innerHTML='<div style="padding:40px 0;text-align:center;color:rgba(255,255,255,.4);font-size:13px">正在加载热门评论…</div>';
   /* QQ 音乐走 /qq/comment, 网易云走 /api/comment/music */
   var apiUrl;
   if(String(id).startsWith('qq_')&&qqSongId){apiUrl='/qq/comment?songid='+encodeURIComponent(qqSongId)}
   else{apiUrl='/api/comment/music?id='+encodeURIComponent(id)}
   fetch(apiUrl).then(function(r){return r.json()}).then(function(d){if(seq!==commentSeq)return;var list=(d&&d.hotComments)||[],html='',i,c,u;if(!list.length){box.innerHTML='<div style="padding:40px 0;text-align:center;color:rgba(255,255,255,.4);font-size:13px">暂无热门评论</div>';$('commentcount').textContent='';return}for(i=0;i<list.length;i++){c=list[i]||{};u=c.user&&c.user.nickname||'匿名用户';var likeCount=c.likedCount||c.praisenum||0;html+='<div class="commentrow"><div class="commentuser">'+esc(u)+(likeCount?' <span style="color:#e88a8a;font-size:11px">♥ '+likeCount+'</span>':'')+'</div><div class="commenttext">'+esc(c.content||'')+'</div></div>'}box.innerHTML=html;$('commentcount').textContent='共'+list.length+'条'}).catch(function(){if(seq!==commentSeq)return;box.innerHTML='<div style="padding:40px 0;text-align:center;color:rgba(255,255,255,.4);font-size:13px">热门评论加载失败</div>';$('commentcount').textContent=''})}
$('commentmask').onclick=closeComments;
$('modelmask').onclick=closeModelPanel;
$('modelclose').onclick=closeModelPanel;
function openModelPanel(){loadAiConfig();if(window.__csRender)window.__csRender();try{bindNativePanel();loadNativeConfig()}catch(e){}$('modelpanel').classList.add('open');$('modelmask').classList.add('open')}
function closeModelPanel(){$('modelpanel').classList.remove('open');$('modelmask').classList.remove('open')}
function parseResolveLine(line){
  var t=(line||'').trim();
  if(!t) return null;
  if(t.charAt(0)==='{'){ try{ var o=JSON.parse(t); if(o&&typeof o==='object'&&!Array.isArray(o)) return o; }catch(e){} }
  return t;
}
function loadAiConfig(){fetch('/ai/config').then(function(r){return r.json()}).then(function(d){if(!d)return;$('cfgEndpoint').value=d.endpoint||'';$('cfgModel').value=d.model||'';$('cfgPrompt').value=d.systemPrompt||'';$('cfgStatus').textContent=d.hasKey?'API Key 已设置':'未设置 API Key';if($('cfgNeteaseApi'))$('cfgNeteaseApi').value=d.neteaseApi||'';if($('cfgQqSearch'))$('cfgQqSearch').value=d.qqSearchApi||'';qqApis=(d.qqResolveApis||[]).map(function(x){return (typeof x==='string')?{url:x}:x}).filter(function(x){return x&&x.url});renderQqApiList();renderSourcePills(d.soundSource||'netease');applySource(d.soundSource||'netease')}).catch(function(){renderSourcePills('netease')})}
/* --- QQ 解析接口列表管理 --- */
var qqApis=[];
var QQ_API_PRESETS=[
 {name:'s01s 通用(默认)',url:'https://tang.api.s01s.cn/music_open_api.php?mid={mid}&quality={quality}',extract:'data.url'},
 {name:'s01s 基础',url:'https://tang.api.s01s.cn/music_open_api.php?mid={mid}'},
 {name:'MetingAPI',url:'https://metingapi.nanorocky.top/?server=tencent&type=url&br={br}&id={mid}'},
 {name:'自定义 / 手动填写',url:''}
];
function renderQqApiList(){
 var box=$('qqApiList');if(!box)return;
 if(!qqApis.length){box.innerHTML='<div class="apiempty">还没有解析接口，点下面「＋ 添加接口」添加一个</div>';return}
 var h='';
 qqApis.forEach(function(it,i){
  var nm=it.label||it.name||('接口 '+(i+1));
  var u=it.url||'';
  var short=u.length>46?u.slice(0,44)+'…':u;
  h+='<div class="apiitem" data-i="'+i+'"><span class="apinm" title="'+esc(nm)+'">'+esc(nm)+'</span><span class="apiurl" title="'+esc(u)+'">'+esc(short)+'</span>'+(it.apiKey?'<span class="apikey">KEY</span>':'')+'<span class="apidel" data-del="'+i+'">✕</span></div>';
 });
 box.innerHTML=h;
 box.querySelectorAll('.apidel').forEach(function(el){el.onclick=function(){var i=+el.getAttribute('data-del');qqApis.splice(i,1);renderQqApiList()}});
}
function renderQqApiPresets(){
 var sel=$('qqApiPreset');if(!sel)return;
 sel.innerHTML=QQ_API_PRESETS.map(function(p,i){return '<option value="'+i+'">'+esc(p.name)+'</option>'}).join('');
 sel.onchange=function(){var p=QQ_API_PRESETS[+sel.value]||{};if(p.url){$('qqApiUrl').value=p.url;$('qqApiExtract').value=p.extract||'';if(!$('qqApiName').value)$('qqApiName').value=(p.name&&p.name.indexOf('自定义')<0)?p.name:''}};
}
function showQqApiForm(show){var f=$('qqApiForm');if(!f)return;f.style.display=show?'block':'none';if(show){renderQqApiPresets();$('qqApiName').value='';$('qqApiUrl').value='';$('qqApiKey').value='';$('qqApiExtract').value='';$('qqApiAdd').style.display='none'}else{$('qqApiAdd').style.display='block'}}
function bindQqApiUI(){
 var a=$('qqApiAdd');if(a)a.onclick=function(){showQqApiForm(true)};
 var c=$('qqApiCancel');if(c)c.onclick=function(){showQqApiForm(false)};
 var o=$('qqApiOk');if(o)o.onclick=function(){
  var url=($('qqApiUrl').value||'').trim();
  if(!url){toast('请填写接口地址');return}
  var item={url:url};
  var nm=($('qqApiName').value||'').trim();if(nm)item.label=nm;
  var k=($('qqApiKey').value||'').trim();if(k)item.apiKey=k;
  var ex=($('qqApiExtract').value||'').trim();if(ex)item.extract=ex;
  qqApis.push(item);renderQqApiList();showQqApiForm(false);toast('已添加，别忘了点「保存配置」');
 };
}
/* --- 音源设置（预留接口：新增音源只需向 SOURCES 添加一项） --- */
var SOURCES=[{id:'netease',name:'网易云音乐'},{id:'qq',name:'QQ 音乐'}];
var pendSource=null;
function applySource(id){
 if(!id)return;
 curSource=id;
 document.querySelectorAll('.sptab').forEach(function(t){t.classList.toggle('active',t.getAttribute('data-src')===id)});
}
function renderSourcePills(sel){
 pendSource=sel||pendSource||'netease';
 var box=$('srcPills');if(!box)return;
 box.innerHTML='';
 SOURCES.forEach(function(sc){
  var d=document.createElement('div');
  d.className='srcpill'+(sc.id===pendSource?' active':'');
  d.textContent=sc.name;d.setAttribute('data-src',sc.id);
  d.onclick=function(){
   pendSource=sc.id;
   box.querySelectorAll('.srcpill').forEach(function(x){x.classList.remove('active')});
   d.classList.add('active');
   applySource(sc.id);
  };
  box.appendChild(d);
 });
}
$('cfgSave').onclick=function(){var body={endpoint:$('cfgEndpoint').value,apiKey:$('cfgApiKey').value,model:$('cfgModel').value,systemPrompt:$('cfgPrompt').value,soundSource:(pendSource||curSource||'netease'),neteaseApi:($('cfgNeteaseApi')?$('cfgNeteaseApi').value.trim():''),qqSearchApi:($('cfgQqSearch')?$('cfgQqSearch').value.trim():''),qqResolveApis:qqApis.slice()};fetch('/ai/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(d){if(d&&d.ok){$('cfgStatus').textContent='已保存: '+(d.model||'未命名')+' @ '+(d.endpoint||'');$('cfgApiKey').value='';applySource(pendSource||curSource);toast('AI模型已配置')}else{$('cfgStatus').textContent='保存失败'}}).catch(function(){$('cfgStatus').textContent='保存失败'})};
$('cfgClear').onclick=function(){fetch('/chat/clear',{method:'POST'}).then(function(r){return r.json()}).then(function(d){if(d&&d.ok){msgCache=[];renderMsgs();toast('聊天记忆已清除')}}).catch(function(){toast('清除失败')})};
/* ================= P2: 原生一起听（登录 / 协议接入） ================= */
var nkMode='local',nkBound=false;
function nkMaskTip(st){
  if(!st||!st.present)return '未设置';
  var t='已设置 · '+st.len+' 字符 · '+esc(st.masked||'');
  if(st.mode)t+=' · 权限 '+st.mode;
  if(st.updatedAt){try{t+=' · '+new Date(st.updatedAt).toLocaleString()}catch(e){}}
  return t;
}
function renderNkModes(){
  var box=$('nkModePills');if(!box)return;
  var MODES=[{id:'local',name:'本地'},{id:'duo',name:'和真人一起听'},{id:'solo_ai',name:'AI 陪听'}];
  box.innerHTML='';
  MODES.forEach(function(m){
    var d=document.createElement('div');
    d.className='srcpill'+(m.id===nkMode?' active':'');
    d.textContent=m.name;d.setAttribute('data-mode',m.id);
    d.onclick=function(){
      nkMode=m.id;
      box.querySelectorAll('.srcpill').forEach(function(x){x.classList.remove('active')});
      d.classList.add('active');
      var tip=$('nkStatus');if(tip)tip.textContent='正在接入「'+m.name+'」…';
      fetch('/mode',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:m.id})}).then(function(r){return r.json().then(function(x){return {code:r.status,d:x}})}).then(function(r){
        var st=r.d||{};
        if(st.ok){
          var conn=!!(st.native&&st.native.connected);
          if(m.id==='local'){toast('已切回本地模式');if(tip)tip.textContent='模式 local · 本地播放';}
          else{toast('已接入：'+m.name+(conn?' · 连接成功':' · 连接中'));if(tip)tip.textContent='模式 '+m.id+' · 已连接='+(conn?'是':'否');try{refreshNativeAvatar()}catch(e){}}
        }else if(r.code===409){
          toast('缺少凭据：'+((st.missing||[]).join('、')||'未知'));
          if(tip)tip.textContent='缺少 cookie：'+((st.missing||[]).join('、')||'');
          loadNativeConfig();
        }else{
          toast('接入失败：'+((st.error)||('HTTP '+r.code)));
          if(tip)tip.textContent='接入失败：'+((st.error)||('HTTP '+r.code));
          loadNativeConfig();
        }
      }).catch(function(){toast('接入请求失败');loadNativeConfig()});
    };
    box.appendChild(d);
  });
}
function loadNativeConfig(){
  fetch('/native/cookie/status').then(function(r){return r.json()}).then(function(d){
    var st=(d&&d.status)||{};
    $('nkAiStatus').textContent=nkMaskTip(st.ai);
    $('nkHumanStatus').textContent=nkMaskTip(st.human);
    $('nkStatus').textContent=st.dir?('凭据目录：'+st.dir):'';
  }).catch(function(){});
  fetch('/mode').then(function(r){return r.json()}).then(function(d){
    nkMode=(d&&d.mode)||'local';renderNkModes();
  }).catch(function(){renderNkModes()});
}
function bindNativePanel(){
  if(nkBound)return;nkBound=true;
  var save=$('nkSave');if(save)save.onclick=function(){
    var jobs=[];
    var ac=($('nkAiCookie')?$('nkAiCookie').value.trim():'');
    var hc=($('nkHumanCookie')?$('nkHumanCookie').value.trim():'');
    if(ac)jobs.push(fetch('/native/cookie/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:'ai',cookie:ac})}).then(function(r){return r.json()}));
    if(hc)jobs.push(fetch('/native/cookie/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:'human',cookie:hc})}).then(function(r){return r.json()}));
    Promise.all(jobs).then(function(){
      if($('nkAiCookie'))$('nkAiCookie').value='';
      if($('nkHumanCookie'))$('nkHumanCookie').value='';
      return fetch('/mode',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:nkMode})}).then(function(r){return r.json().then(function(d){return {code:r.status,d:d}})});
    }).then(function(r){
      var d=r.d||{};
      if(d.ok){toast('原生一起听：模式 '+(d.mode||nkMode)+' 已生效');$('nkStatus').textContent='模式 '+(d.mode||nkMode)+' · 已连接='+((d.native&&d.native.connected)?'是':'否（协议待 P3/P4）');}
      else if(r.code===409){toast('缺少凭据：'+((d.missing||[]).join('、')||'未知'));$('nkStatus').textContent='缺少 cookie：'+((d.missing||[]).join('、')||'');}
      else{toast('切换失败：'+((d&&d.error)||r.code))}
      loadNativeConfig();
    }).catch(function(e){toast('保存失败');$('nkStatus').textContent=String(e)});
  };
  var clr=$('nkClear');if(clr)clr.onclick=function(){
    if(!confirm('确定清除全部原生凭据（ai + human cookie）？'))return;
    fetch('/native/cookie/clear',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}).then(function(r){return r.json()}).then(function(){toast('凭据已清除');loadNativeConfig()}).catch(function(){toast('清除失败')});
  };
  var aq=$('nkAiQr');if(aq)aq.onclick=function(){openQrLogin('ai')};
  var hq=$('nkHumanQr');if(hq)hq.onclick=function(){openQrLogin('human')};
  var as=$('nkAiSms');if(as)as.onclick=function(){openSmsLogin('ai')};
  var hs=$('nkHumanSms');if(hs)hs.onclick=function(){openSmsLogin('human')};
}
/* ---------- 扫码登录（二维码弹窗 + 轮询） ---------- */
var qrWho='ai',qrTimer=null,qrSeq=0,qrBusy=false;
function qrRender(text,size){
  var box=$('qrbox');if(!box)return;
  box.innerHTML='';
  try{
    var qr=qrcode(0,'M');qr.addData(text);qr.make();
    var img=document.createElement('img');
    img.src=qr.createDataURL(5,4);
    box.appendChild(img);
    var sp=$('qrspin');if(sp)sp.style.display='none';
  }catch(e){
    box.innerHTML='<span id="qrspin" style="color:#666">二维码生成失败</span>';
  }
}
function qrSetStatus(txt,color){
  var s=$('qrstatus');if(s){s.textContent=txt;s.style.color=color||'rgba(255,255,255,.6)'}
}
function qrStopPoll(){if(qrTimer){clearInterval(qrTimer);qrTimer=null}}
function qrClose(){
  qrStopPoll();
  if(typeof smsStopTimer==='function')smsStopTimer();
  var p=$('qrpanel'),m=$('qrmask');
  if(p)p.classList.remove('open');if(m)m.classList.remove('open');
  try{fetch('/native/login/qr/cancel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:qrWho})}).catch(function(){})}catch(e){}
}
function openQrLogin(who){
  qrWho=(who==='human')?'human':'ai';
  var p=$('qrpanel'),m=$('qrmask');
  $('qrtitle').textContent=(qrWho==='ai'?'扫码登录 · AI 身份':'扫码登录 · 真人身份');
  $('qrdone').style.display='none';
  $('qrrefresh').style.display='';
  qrTab('qr');
  if(p)p.classList.add('open');if(m)m.classList.add('open');
  qrStart();
}
/* ---------- 登录弹窗 Tab 切换（扫码 / 短信） ---------- */
function qrTab(name){
  var isSms=(name==='sms');
  var tq=$('qtabQr'),ts=$('qtabSms');
  if(tq)tq.classList.toggle('on',!isSms);
  if(ts)ts.classList.toggle('on',isSms);
  var pq=$('qrpaneQr'),ps=$('qrpaneSms');
  if(pq)pq.style.display=isSms?'none':'';
  if(ps)ps.style.display=isSms?'':'none';
  var t=$('qrtitle');
  if(t)t.textContent=isSms?('短信登录 · '+(qrWho==='ai'?'AI 身份':'真人身份')):('扫码登录 · '+(qrWho==='ai'?'AI 身份':'真人身份'));
}
/* ---------- 短信验证码登录 ---------- */
var smsTimer=null,smsBusy=false;
function smsSetStatus(txt,color){var s=$('smsStatus');if(s){s.textContent=txt||'';s.style.color=color||'rgba(255,255,255,.5)'}}
function smsStopTimer(){if(smsTimer){clearInterval(smsTimer);smsTimer=null}}
function smsCooldown(sec){
  smsStopTimer();
  var btn=$('smsSend');if(!btn)return;
  var left=Math.max(0,parseInt(sec,10)||0);
  if(left<=0){btn.disabled=false;btn.textContent='获取验证码';return}
  btn.disabled=true;
  btn.textContent=left+'s';
  smsTimer=setInterval(function(){
    left--;
    if(left<=0){smsStopTimer();btn.disabled=false;btn.textContent='获取验证码';}
    else{btn.textContent=left+'s';}
  },1000);
}
function openSmsLogin(who){
  qrWho=(who==='human')?'human':'ai';
  qrStopPoll();
  var p=$('qrpanel'),m=$('qrmask');
  smsSetStatus('');
  smsCooldown(0);
  qrTab('sms');
  if(p)p.classList.add('open');if(m)m.classList.add('open');
}
function smsSendCode(){
  if(smsBusy)return;
  var phone=($('smsPhone')?$('smsPhone').value:'').replace(/[\s-]/g,'');
  if(!/^1[3-9]\d{9}$/.test(phone)){smsSetStatus('请输入正确的 11 位手机号','#ec4141');return}
  smsBusy=true;
  var btn=$('smsSend');if(btn){btn.disabled=true;btn.textContent='发送中…';}
  smsSetStatus('正在发送验证码…');
  fetch('/native/login/sms/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:qrWho,phone:phone})})
    .then(function(r){return r.json().then(function(d){return {code:r.status,d:d}})})
    .then(function(r){
      smsBusy=false;
      var d=r.d||{};
      if(d.ok){
        smsSetStatus('✅ '+(d.message||'验证码已发送'),'#5bd68a');
        smsCooldown(Math.ceil((d.cooldownMs||60000)/1000));
      }else if(r.code===429||d.cooldown){
        smsSetStatus('⏳ '+(d.message||'操作过于频繁'),'#f5c451');
        smsCooldown(d.waitSeconds||60);
      }else{
        smsSetStatus('✗ '+(d.message||d.error||('发送失败 '+r.code)),'#ec4141');
        if(btn){btn.disabled=false;btn.textContent='获取验证码';}
      }
    })
    .catch(function(e){
      smsBusy=false;
      smsSetStatus('网络错误：'+String(e),'#ec4141');
      var btn=$('smsSend');if(btn){btn.disabled=false;btn.textContent='获取验证码';}
    });
}
function smsDoLogin(){
  if(smsBusy)return;
  var phone=($('smsPhone')?$('smsPhone').value:'').replace(/[\s-]/g,'');
  var code=($('smsCode')?$('smsCode').value:'').trim();
  if(!/^1[3-9]\d{9}$/.test(phone)){smsSetStatus('请输入正确的 11 位手机号','#ec4141');return}
  if(!/^\d{4,8}$/.test(code)){smsSetStatus('请输入收到的短信验证码','#ec4141');return}
  smsBusy=true;
  var btn=$('smsLogin');if(btn){btn.disabled=true;btn.textContent='登录中…';}
  smsSetStatus('正在校验并写入 cookie…');
  fetch('/native/login/sms/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:qrWho,phone:phone,captcha:code})})
    .then(function(r){return r.json().then(function(d){return {code:r.status,d:d}})})
    .then(function(r){
      smsBusy=false;
      var d=r.d||{};
      if(d.ok){
        smsSetStatus('✅ 登录成功，cookie 已写入（'+qrWho+'）','#5bd68a');
        $('smsPhone')&&($('smsPhone').value='');
        $('smsCode')&&($('smsCode').value='');
        $('nkAiCookie')&&($('nkAiCookie').value='');
        $('nkHumanCookie')&&($('nkHumanCookie').value='');
        smsCooldown(0);
        loadNativeConfig();
        toast('短信登录成功：'+(qrWho==='ai'?'AI 身份':'真人身份'));
        setTimeout(qrClose,900);
      }else{
        smsSetStatus('✗ '+(d.message||d.error||('登录失败 '+r.code)),'#ec4141');
        if(btn){btn.disabled=false;btn.textContent='登录';}
      }
    })
    .catch(function(e){
      smsBusy=false;
      smsSetStatus('网络错误：'+String(e),'#ec4141');
      var btn=$('smsLogin');if(btn){btn.disabled=false;btn.textContent='登录';}
    });
}
function qrStart(){
  qrStopPoll();
  var seq=++qrSeq;
  qrBusy=true;
  $('qrbox').innerHTML='<span id="qrspin">正在生成二维码…</span>';
  qrSetStatus('正在向网易申请二维码…');
  fetch('/native/login/qr/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:qrWho})})
    .then(function(r){return r.json()})
    .then(function(d){
      if(seq!==qrSeq)return;
      if(!d||!d.ok||!d.qrUrl){qrSetStatus('二维码申请失败：'+((d&&d.error)||'未知错误'),'#ec4141');qrBusy=false;return}
      qrRender(d.qrUrl,5);
      qrSetStatus('等待扫码…（二维码约 4 分钟有效）');
      qrBusy=false;
      qrPoll(seq);
      qrTimer=setInterval(function(){qrPoll(seq)},2000);
    })
    .catch(function(e){if(seq!==qrSeq)return;qrSetStatus('网络错误：'+String(e),'#ec4141');qrBusy=false});
}
function qrPoll(seq){
  if(seq!==qrSeq||qrBusy)return;
  qrBusy=true;
  fetch('/native/login/qr/poll',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({who:qrWho})})
    .then(function(r){return r.json()})
    .then(function(d){
      qrBusy=false;
      if(seq!==qrSeq)return;
      var code=(d&&d.code)||0;
      if(code===801){qrSetStatus('等待扫码…');}
      else if(code===802){qrSetStatus('已扫码，请在手机上确认','#f5c451');}
      else if(code===803&&d&&d.ok){
        qrStopPoll();
        qrSetStatus('✅ 登录成功，cookie 已写入（'+qrWho+'）','#5bd68a');
        $('qrrefresh').style.display='none';
        $('qrdone').style.display='';
        $('nkAiCookie')&&($('nkAiCookie').value='');
        $('nkHumanCookie')&&($('nkHumanCookie').value='');
        loadNativeConfig();
        toast('扫码登录成功：'+(qrWho==='ai'?'AI 身份':'真人身份'));
      }
      else if(code===800){
        qrStopPoll();
        qrSetStatus('二维码已过期，请点「刷新二维码」','#ec4141');
        $('qrrefresh').style.display='';
      }
      else{
        qrSetStatus((d&&d.message)||('状态 '+code));
      }
    })
    .catch(function(){qrBusy=false;if(seq===qrSeq)qrSetStatus('轮询失败，重试中…','#f5c451')});
}
$('qrmask').onclick=qrClose;
$('qrclose').onclick=qrClose;
$('qrrefresh').onclick=function(){qrStart()};
$('qrdone').onclick=qrClose;
$('qtabQr')&&($('qtabQr').onclick=function(){qrStopPoll();qrTab('qr');qrStart()});
$('qtabSms')&&($('qtabSms').onclick=function(){openSmsLogin(qrWho)});
$('smsSend')&&($('smsSend').onclick=smsSendCode);
$('smsLogin')&&($('smsLogin').onclick=smsDoLogin);
$('smsCode')&&($('smsCode').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();smsDoLogin()}}));
$('smsPhone')&&($('smsPhone').addEventListener('input',function(){this.value=this.value.replace(/\D/g,'').slice(0,11)}));
$('smsCode')&&($('smsCode').addEventListener('input',function(){this.value=this.value.replace(/\D/g,'').slice(0,8)}));

$('listbtn').onclick=function(){renderAny();$('plpanel').classList.add('open');var m=$('plmask');if(m)m.classList.add('open')};
$('cvmore').onclick=function(){renderAny();$('plpanel').classList.add('open');var m=$('plmask');if(m)m.classList.add('open')};
(function(){var m=$('plmask');if(m)m.onclick=function(){m.classList.remove('open');$('plpanel').classList.remove('open')}})();
var plTab='list';
function renderAny(){if(plTab==='fav')renderFavorites();else renderPlaylist()}
function bindPlTabs(){var ts=document.querySelectorAll('#pltabs .pltab');for(var i=0;i<ts.length;i++)ts[i].onclick=function(){plTab=this.getAttribute('data-tab');var _t=document.querySelectorAll('#pltabs .pltab');for(var j=0;j<_t.length;j++)_t[j].classList.toggle('on',_t[j]===this);renderAny()}};bindPlTabs();
function renderFavorites(){
 var b=$('plbody'),cur=S.song?String(S.song.id):null,n=S.favorites.length;
 $('plcount').textContent='共'+n+'首';
 bindPlList(b,S.favorites,true,cur);
}
function bindPlList(b,list,fav,cur){
 var n=list.length,i;
 b.innerHTML='';
 for(i=0;i<n;i++){var g=list[i];var _c=String(g.id)===cur;(function(g,i,_c,fav){var row=document.createElement('div');row.className='plrow'+(_c?' cur':'');row.innerHTML='<div class="plidx">'+(_c?'♪':(i+1))+'</div><div class="plinfo"><div class="plnm">'+esc(g.name||'未知')+'</div><div class="plar">'+esc(g.artist||'')+'</div></div><div class="pldel">✕</div>';row.addEventListener('click',function(e){
  if(e.target&&e.target.classList&&e.target.classList.contains('pldel')){e.stopPropagation();
   if(fav){api('/favorite/toggle',{song:g}).then(function(r){S.favorites=r.favorites||S.favorites;renderFavorites();toast('已从红心歌单移除')})}
   else{api('/playlist/clear',{index:i}).then(function(){return api('/state')}).then(function(s){s=s&&s.state?s.state:s;if(s&&Array.isArray(s.playlist)){S.playlist=s.playlist;renderPlaylist()}})}
   return}
  var id=String(g.id);
  if(id===String(S.song.id)){var m=$('plmask');if(m)m.classList.remove('open');$('plpanel').classList.remove('open');return}
  var song=g;
  if(!song)return toast('这首歌不在队列里啦');
  toast('正在切歌…');
  fetch('/api/song/url/v1?id='+song.id+'&level=exhigh').then(function(r){return r.json()}).then(function(ur){
   var d=(ur&&ur.data&&ur.data[0])||{};
   if(d.url)song.url=d.url;
   return api('/control',{action:'load',song:song});
  }).then(function(ok){if(ok){var m=$('plmask');if(m)m.classList.remove('open');$('plpanel').classList.remove('open');toast('已切歌')}else toast('音源失效了，换一首吧')});
 });b.appendChild(row);})(g,i,_c,fav)}
 if(!n)b.innerHTML='<div style="padding:40px 0;text-align:center;color:rgba(255,255,255,.35);font-size:13px">'+(fav?'还没有红心歌曲，点♥收藏吧 ❤️':'列表空空的，去搜一首吧 🎵')+'</div>';
}
function renderPlaylist(){
 var b=$('plbody'),cur=S.song?String(S.song.id):null;
 $('plcount').textContent='共'+S.playlist.length+'首';
 bindPlList(b,S.playlist,false,cur);
}
$('plclear').onclick=function(){if(plTab==='fav'){api('/favorite/clear').then(function(){return api('/state')}).then(function(s){s=s&&s.state?s.state:s;if(s&&Array.isArray(s.favorites)){S.favorites=s.favorites;renderFavorites();updateLikeBtn();toast('已清空红心歌单')}})}else{api('/playlist/clear',{all:true}).then(function(){return api('/state')}).then(function(s){s=s&&s.state?s.state:s;if(s&&Array.isArray(s.playlist)){S.playlist=s.playlist;renderPlaylist();toast('已清空待播')}})}};
$('bmore').onclick=openModelPanel;$('backbtn').onclick=openDressPanel;
function updateLikeBtn(){
 var lb=$('likebtn');
 if(!lb)return;
 var cur=S.song&&S.song.id?String(S.song.id):null;
 var fav=S.favorites?S.favorites.some(function(g){return g&&String(g.id)===cur}):false;
 lb.classList.toggle('on',fav);
}
$('likebtn').onclick=function(){var cur=S.song;if(!cur||!cur.id){toast('没有正在播放的歌曲');return}var was=S.favorites?S.favorites.some(function(g){return String(g.id)===String(cur.id)}):false;var self=this;api('/favorite/toggle',{song:cur}).then(function(r){if(r&&r.ok&&Array.isArray(r.favorites)){S.favorites=r.favorites;self.classList.toggle('on',r.added);flyStar(r.added);if(plTab==='fav'&&$('plpanel').classList.contains('open'))renderFavorites();if(!was&&r.added)toast('已收藏到红心歌单♥')}else toast('操作失败')})};
var panelOpen=false,msgCache=[];
function openChat(o){panelOpen=o;$('chatpage').classList.toggle('on',o);$('tabChat').classList.toggle('on',o);$('tabMusic').classList.toggle('on',!o);if(o){S.unread=0;$('msgbadge').classList.remove('show');$('tabbadge').classList.remove('show');refreshMsgs()}}
$('tabChat').onclick=function(){openChat(true)};$('chatact').onclick=openComments;
$('tabMusic').onclick=function(){openChat(false)};
 /* 那个圆圈: 点击发送 */
(function(){
  var sb=$('sendbtn');
  var touched=false;
  function fire(){var t=$('msginput').value.replace(/^\s+|\s+$/g,'');if(!t){toast('说点什么吧~');return}sendMsg()}
  function on(){sb.style.background='#ec4141'}
  function off(){sb.style.background='#3a3835'}
  sb.addEventListener('touchstart',function(e){touched=true;e.preventDefault();on();try{navigator.vibrate&&navigator.vibrate(20)}catch(x){}},{passive:false});
  sb.addEventListener('touchend',function(e){e.preventDefault();off();fire()},{passive:false});
  sb.addEventListener('touchcancel',function(){off()});
  sb.addEventListener('mousedown',function(e){if(touched)return;on()});
  sb.addEventListener('mouseup',function(e){if(touched)return;off();fire()});
  sb.addEventListener('mouseleave',function(){if(touched)return;off()});
})();
/* ═══ 输入法兼容: 回车发送 ═══ */
$('msginput').addEventListener('keydown',function(e){
  if(e.key==='Enter'||e.keyCode===13){e.preventDefault();sendMsg();}
});
function sendMsg(){var t=$('msginput').value.replace(/^\s+|\s+$/g,'');if(!t)return;$('msginput').value='';api('/chat',{from:'me',name:'用户',text:t});setTimeout(refreshMsgs,400);fetch('/ai/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})}).then(function(r){return r.json()}).then(function(d){if(!d||!d.ok){toast(d&&d.error||'AI回复失败');refreshMsgs()}}).catch(function(){toast('AI回复失败');refreshMsgs()})}
function refreshMsgs(){fetch('/chat/history').then(function(r){return r.json()}).then(function(d){msgCache=(d&&(d.msgs||d.messages))||[];renderMsgs()}).catch(function(){})}
 function renderMsgs(){
  var box=$('msgs'),html='',i,m;
 for(i=0;i<msgCache.length;i++){m=msgCache[i];var ai=m.from==='ai';
  html+='<div class="mrow '+(ai?'ai':'me')+'"><img class="mav" src="/avatar/'+(ai?'by':'me')+'?t='+AVT+'" alt=""><div class="txt">'+esc(m.text)+'</div></div>';
  /* 推荐歌曲卡片 */
  if(ai&&m.recommend&&m.recommend.length){
   html+='<div class="mrow ai"><img class="mav" src="/avatar/by?t='+AVT+'" alt=""><div class="txt" style="padding:0">';
   for(var j=0;j<m.recommend.length;j++){
    var r=m.recommend[j];
    html+='<div class="recCard" data-id="'+esc(r.id)+'" data-name="'+esc(r.name)+'" data-artist="'+esc(r.artist)+'">'
      +'<div class="recCardPlay"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#fff"/></svg></div>'
      +'<div class="recCardInfo"><div class="recCardName">'+esc(r.name)+'</div><div class="recCardArtist">'+esc(r.artist)+'</div></div>'
      +'</div>';
   }
   html+='</div></div>';
   }
   /* 歌单确认卡片 */
   if(ai&&m.playlistCard){
    var pc=m.playlistCard, done=m.plDone;
    html+='<div class="mrow ai"><img class="mav" src="/avatar/by?t='+AVT+'" alt=""><div class="txt" style="padding:0">';
    html+='<div class="plCard" data-name="'+esc(pc.name)+'">'
      +'<div class="plCardHead"><div class="plCardIcon"><svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg></div>'
      +'<div style="min-width:0"><div class="plCardTitle">'+esc(pc.name)+'</div><div class="plCardSub">共 '+pc.count+' 首 · 确认后整单替换播放列表</div></div></div>';
    if(pc.songs&&pc.songs.length){
     var names=[];for(var k=0;k<pc.songs.length;k++)names.push(esc(pc.songs[k].name));
     html+='<div class="plCardSongs">'+names.join(' · ')+(pc.count>pc.songs.length?' 等':'')+'</div>';
    }
    if(done){html+='<div class="plCardDone">'+(done==='ok'?'✅ 已整单替换':'已取消')+'</div>';}
    else{
     html+='<div class="plCardBtns"><div class="plBtn plBtnOk">确认替换</div><div class="plBtn plBtnNo">取消</div></div>';
    }
    html+='</div></div></div>';
   }
  }
   box.innerHTML=html||'';
  box.scrollTop=box.scrollHeight;
  /* 绑定歌单确认卡片按钮 */
  var plCards=box.querySelectorAll('.plCard');
  for(i=0;i<plCards.length;i++){(function(c){
   var ok=c.querySelector('.plBtnOk'), no=c.querySelector('.plBtnNo');
   if(ok)ok.onclick=function(){
    toast('正在整单替换…');
    api('/playlist/confirm',{}).then(function(r){
     if(r&&r.ok){toast('已替换 '+r.count+' 首，正在播放《'+r.playing+'》');flyStar(true);if(typeof refreshPlaylist==='function')refreshPlaylist();}
     else toast((r&&r.error)||'替换失败');
     refreshMsgs();
    }).catch(function(){toast('替换失败');refreshMsgs()});
   };
   if(no)no.onclick=function(){api('/playlist/reject',{}).then(function(){toast('已取消');refreshMsgs()}).catch(function(){refreshMsgs()})};
  })(plCards[i])}
  /* 绑定推荐卡片点击 */
 var cards=box.querySelectorAll('.recCard');
 for(i=0;i<cards.length;i++){(function(c){c.onclick=function(){
  var sg={id:c.dataset.id,name:c.dataset.name,artists:[{name:c.dataset.artist}],artist:c.dataset.artist,album:{}};
  toast('正在点歌…');
  var levels=['exhigh','standard'];
  function tryLevel(i){
   if(i>=levels.length){toast('这首暂时没有音源');return}
   fetch('/api/song/url/v1?id='+sg.id+'&level='+levels[i]).then(function(r){return r.json()}).then(function(ur){
    var d=(ur&&ur.data&&ur.data[0])||{};
    if(d.url){
     var song={id:String(sg.id),name:sg.name,artist:sg.artist,pic:'',url:d.url,duration:d.time||0};
     api('/control',{action:'load',song:song,by:'用户'}).then(function(){toast('已播放');flyStar(true)});
    }else tryLevel(i+1);
   }).catch(function(){tryLevel(i+1)});
  }
  tryLevel(0);
 }})(cards[i])}
}
function flyStar(on){
 if(!window.lottie)return;
 var d=document.createElement('div');d.className='ltl';d.style.left=(46+Math.random()*10)+'%';$('fxlayer').appendChild(d);
 try{
  var data=on?(Math.random()<.5?(ASSETS.ltNoToDouble||ASSETS.ltLikeStar):ASSETS.ltLikeStar):ASSETS.ltLikeStar;
  var a=lottie.loadAnimation({container:d,renderer:'svg',loop:false,autoplay:true,animationData:data});
  a.addEventListener('complete',function(){if(d.parentNode)d.remove()});
 }catch(e){if(d.parentNode)d.remove()}
 setTimeout(function(){if(d.parentNode)d.remove()},2600);
}
function popHeart(){var h=document.createElement('div');h.className='popheart';h.textContent='💖';h.style.left=(46+Math.random()*10)+'%';$('fxlayer').appendChild(h);setTimeout(function(){if(h.parentNode)h.remove()},1150)}
function emojiRain(em){for(var i=0;i<7;i++){(function(i){setTimeout(function(){var e=document.createElement('div');e.className='rain';e.textContent=em;e.style.left=(8+Math.random()*84)+'%';$('fxlayer').appendChild(e);setTimeout(function(){if(e.parentNode)e.remove()},2700)},i*160)})(i)}}
function showBubble(el,t){if(!t)return;el.textContent=t.length>12?t.slice(0,12)+'…':t;el.classList.add('show');clearTimeout(el._t);el._t=setTimeout(function(){el.classList.remove('show')},3000)}
function onChatMsg(m){
 if(!m)return;
 refreshMsgs();
 if(m.from==='ai'){
  showBubble($('byBubble'),m.text);if(dressState.fxChat!==false){emojiRain(['💖','✨','🎵','🌟'][Date.now()%4]);popHeart();}
  if(!panelOpen){S.unread++;var b=$('msgbadge'),b2=$('tabbadge');var tx=S.unread>9?'9+':String(S.unread);b.textContent=tx;b.classList.add('show');b2.textContent=tx;b2.classList.add('show')}
  if(dressState.fxChat!==false){try{new Audio('data:audio/mp3;base64,'+ASSETS.chatNotice).play().catch(function(){})}catch(e){}}
 }else{showBubble($('myBubble'),m.text)}
}
var sp=$('searchpanel'),spi=$('spinput'),spr=$('spresults');
var curSource='netease';
/* 音源切换 */
document.querySelectorAll('.sptab').forEach(function(tab){
 tab.onclick=function(){
  document.querySelectorAll('.sptab').forEach(function(t){t.classList.remove('active')});
  tab.classList.add('active');
  curSource=tab.getAttribute('data-src');
  spr.innerHTML='<div class="spempty">切换到'+(curSource==='qq'?'QQ音乐':'网易云')+'，搜一首想听的歌吧 🎵</div>';
 };
});
$('morebtn').onclick=function(){sp.classList.add('open');spi.value='';spr.innerHTML='<div class="spempty">搜一首想听的歌吧 🎵</div>';setTimeout(function(){try{spi.focus()}catch(e){}},150)};
$('spback').onclick=function(){sp.classList.remove('open');try{spi.blur()}catch(e){}};
spi.addEventListener('keydown',function(e){if(e.key==='Enter')doSearch()});
$('spgo').onclick=doSearch;
function doSearch(){
 var kw=spi.value.replace(/^\s+|\s+$/g,'');if(!kw)return;
 spr.innerHTML='<div class="spempty">搜索中…</div>';
 if(curSource==='qq'){
  /* QQ 音乐搜索 */
  fetch('/qq/search?keywords='+encodeURIComponent(kw)+'&limit=20').then(function(r){return r.json()}).then(function(r){
   var list=(r&&r.result&&r.result.songs)||[];
   if(!list.length){spr.innerHTML='<div class="spempty">没找到「'+esc(kw)+'」相关的歌</div>';return}
   var html='',i,sg,ar;
   for(i=0;i<list.length;i++){sg=list[i];
    ar=sg.artist||'';
    html+='<div class="spitem" data-i="'+i+'"><div class="spidx">'+(i+1)+'</div><div class="spinfo"><div class="spnm">'+esc(sg.name||'未知')+'</div><div class="spar">'+esc(ar)+'</div></div><div class="spplay"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>';
   }
   spr.innerHTML=html;
   var rows=spr.querySelectorAll('.spitem');
   for(i=0;i<rows.length;i++){(function(row,idx){row.onclick=function(){pickQQSong(list[idx])}})(rows[i],i)}
  }).catch(function(){spr.innerHTML='<div class="spempty">网络开小差了，再试一次？</div>'});
 }else{
  /* 网易云搜索 */
  fetch('/api/search?keywords='+encodeURIComponent(kw)+'&limit=20').then(function(r){return r.json()}).then(function(r){
   var list=(r&&r.result&&r.result.songs)||[];
   if(!list.length){spr.innerHTML='<div class="spempty">没找到「'+esc(kw)+'」相关的歌</div>';return}
   var html='',i,sg,ar,al;
   for(i=0;i<list.length;i++){sg=list[i];
    ar=((sg.artists||[]).map(function(a){return a.name}).join('/'))||sg.artist||'';
    al=(sg.album&&(sg.album.name||sg.album))||'';
    html+='<div class="spitem" data-i="'+i+'"><div class="spidx">'+(i+1)+'</div><div class="spinfo"><div class="spnm">'+esc(sg.name||'未知')+'</div><div class="spar">'+esc(ar)+(al?' · '+esc(al):'')+'</div></div><div class="spplay"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>';
   }
   spr.innerHTML=html;
   var rows=spr.querySelectorAll('.spitem');
   for(i=0;i<rows.length;i++){(function(row,idx){row.onclick=function(){pickSong(list[idx])}})(rows[i],i)}
  }).catch(function(){spr.innerHTML='<div class="spempty">网络开小差了，再试一次？</div>'});
 }
}
/* 网易云点歌 */
function pickSong(sg){
 toast('正在点歌…');
 var levels=['exhigh','standard'];
 function tryLevel(i){
  if(i>=levels.length){toast('这首暂时没有音源，换一首吧');flyStar(false);return}
  fetch('/api/song/url/v1?id='+sg.id+'&level='+levels[i]).then(function(r){return r.json()}).then(function(ur){
   var d=(ur&&ur.data&&ur.data[0])||{};
   if(d.url&&(d.code===200||!d.code)){
    var ar=((sg.artists||[]).map(function(a){return a.name}).join('/'))||'';
    var finish=function(pic){
     var song={id:String(sg.id),name:sg.name||'未知',artist:ar,pic:pic,url:d.url,duration:d.time||sg.duration||0};
     api('/control',{action:'load',song:song,by:'用户'}).then(function(ok){
      if(ok){sp.classList.remove('open');toast('已为房间播放');flyStar(true)}
      else toast('点歌失败，再试试');
     });
    };
    var pic0=(sg.album&&sg.album.picUrl)||(sg.album&&sg.album.pic)||'';
    if(pic0){finish(pic0)}
    else{
     fetch('/api/song/detail?ids='+sg.id).then(function(r){return r.json()}).then(function(dd){
      var al=(dd&&dd.songs&&dd.songs[0]&&dd.songs[0].al)||{};
      finish(al.picUrl||'');
     }).catch(function(){finish('')});
    }
   }else tryLevel(i+1);
  }).catch(function(){tryLevel(i+1)});
 }
 tryLevel(0);
}
/* QQ 音乐点歌 */
function pickQQSong(sg){
  toast('正在点歌…');
  /* 直接让服务端 load, 服务端在 load 时解析 URL, 不走前端两步 */
  var song={id:'qq_'+sg.id,name:sg.name||'未知',artist:sg.artist||'',pic:sg.pic||'',url:'',duration:sg.duration||0,qq_songid:sg.songid||0};
  api('/control',{action:'load',song:song,autoplay:true,by:'用户'}).then(function(ok){
   if(ok){sp.classList.remove('open');toast('已为房间播放');flyStar(true)}
   else toast('点歌失败，再试试');
  }).catch(function(){toast('点歌失败，再试试')});
 }
