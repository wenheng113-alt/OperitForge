     var _tr3='transform .34s cubic-bezier(.25,.8,.3,1),opacity .3s ease';
     _vb.style.webkitTransition=_tr3;_vb.style.transition=_tr3;
     var _fin=false,_finOnce=function(){if(_fin)return;_fin=true;if(!_vswapBusy)return;var _b=$('vinylbox'),_vv2=_b?_b.querySelector('#vinyl'):null;try{var _gh=_hnd?_hnd.querySelector('#vinyl'):null;if(_vv2&&_gh&&S.playing){var _m3=new DOMMatrixReadOnly(getComputedStyle(_gh).transform==='none'?'':getComputedStyle(_gh).transform);var _a3=Math.atan2(_m3.m12,_m3.m11)*180/Math.PI;if(isFinite(_a3)){_vv2.style.webkitAnimation=_vv2.style.animation='none';void _vv2.offsetWidth;_vv2.style.webkitAnimation=_vv2.style.animation='spin 20s linear infinite';var _d3=(-((_a3/360)*20)).toFixed(3);_vv2.style.webkitAnimationDelay=_vv2.style.animationDelay=_d3+'s';_vv2.style.webkitAnimationPlayState=_vv2.style.animationPlayState='running'}}}catch(e){}if(_b){_b.style.webkitTransition='none';_b.style.transition='none';_b.style.opacity='1'}if(_vw._handoffDone)_vw._handoffDone();_vswapBusy=false}; /* 实时对齐邻居碟最新角度再接管, 转动零中断 */
     var _hnd=(song.pic&&_vw._nbSync)?_vw._nbSync(song.pic):null;
     var _cvg=_hnd?_hnd.querySelector('#cover'):null;
     var _arm=function(){setTimeout(_finOnce,90)};
     if(_cvg&&!_cvg.complete){var _ct=setTimeout(_finOnce,260);_cvg.addEventListener('load',function(){clearTimeout(_ct);_arm()},{once:true});_cvg.addEventListener('error',function(){clearTimeout(_ct);_finOnce()},{once:true})}
     else{_arm()}
    }else if(_vb&&!_vswapBusy){ /* 常规换碟: 双碟轨道推挤(busy时不走) */
    var _pv=_vdir==='prev';
    var _W=window.innerWidth||360;
     var _enterX=_pv?-_W:_W,_exitX=_pv?_W:-_W; /* 官方轨道语义: next整轨左移(旧左出新右进), prev镜像 */
    var _echo=_vb.cloneNode(true); /* 替身=旧碟留原位(保留id继承全部样式), 恒距一屏物理零重叠 */
    _echo.style.zIndex='6';_echo.style.pointerEvents='none';_echo.style.transform='translateX(0)';_echo.style.opacity='1';
    if(_vb.parentNode)_vb.parentNode.appendChild(_echo);
    _vb.style.webkitTransition='none';_vb.style.transition='none';
    _vb.style.webkitTransform='translateX('+_enterX+'px)';_vb.style.transform='translateX('+_enterX+'px)';
    _vb.style.opacity='0';
    void _vb.offsetWidth; /* 强制reflow锁定起点 */
    var _tr='transform .42s cubic-bezier(.32,.72,.34,1),opacity .38s ease';
    _echo.style.webkitTransition=_tr;_echo.style.transition=_tr;
    _vb.style.webkitTransition=_tr;_vb.style.transition=_tr;
    requestAnimationFrame(function(){requestAnimationFrame(function(){
     _echo.style.webkitTransform='translateX('+_exitX+'px)';_echo.style.transform='translateX('+_exitX+'px)';_echo.style.opacity='0';
     _vb.style.webkitTransform='translateX(0)';_vb.style.transform='translateX(0)';_vb.style.opacity='1';
    })});
    setTimeout(function(){
     if(_echo.parentNode)_echo.parentNode.removeChild(_echo);
     ['webkitTransition','transition','webkitTransform','transform','opacity'].forEach(function(k){try{_vb.style[k]=''}catch(e){}});
     _vswapBusy=false;
    },480);
    _vswapBusy=true;
   }
  }
 if(song&&song.id!=null)_vinylLast=String(song.id);$('songname').textContent=song.name||'未知曲目';
 $('artist').textContent=song.artist||'';
 $('ttname').textContent=song.name||'未知曲目';
 $('ttartist').textContent=song.artist||'';
 $('viptag').style.display='';
