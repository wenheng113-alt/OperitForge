    {id:'disc_gold',name:'流金岁月',svg:makeDiscSVG({bg:'#2a2008',ring:'#4a4010',center:'#c0a040',labelBg:'#3a3010',labelRing:'#807020',groove:'rgba(255,215,0,0.06)',highlight:'#ffd700'})},
    {id:'disc_rainbow',name:'霓虹彩虹',svg:makeDiscSVG({bg:'#1a0020',ring:'#300040',center:'#ff4080',labelBg:'#200030',labelRing:'#600080',groove:'rgba(255,100,255,0.04)',highlight:'#ff00ff'})},
