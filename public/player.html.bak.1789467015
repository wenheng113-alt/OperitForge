 })})}catch(e2){}
 if(_shouldPlay&&!window.__micHold){
  /* 正在播放时被系统暂停, 尝试恢复 */
  setTimeout(function(){
   if(_shouldPlay&&audio.paused&&!window.__micHold){
    audio.play().catch(function(){
     setTimeout(function(){if(_shouldPlay&&audio.paused)audio.play().catch(function(){})},1000);
    });
   }
  },300);
 }else{
  if(!document.hidden)releaseWakeLock();
 }
});
/* 页面进入后台: 主动 audio.play() 对抗 Android WebView 自动暂停 + 保持 Wake Lock */
document.addEventListener('visibilitychange',function(){
 /* 诊断 */
 try{fetch('/debug',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
  event:'visibilitychange',
  hidden:document.hidden,
  Splaying:S.playing,
  audioPaused:audio.paused,
  ts:Date.now()
 })})}catch(e2){}
 if(document.hidden){
  if(S.playing&&!window.__micHold){
   audio.play().catch(function(){});
  }
  acquireWakeLock();
  if(audio.duration>0){
   try{pushControl({action:'seek',position:Math.round(audio.currentTime*1000)})}catch(e){}
  }
 }else{
  if(S.playing)ensurePlay();
  acquireWakeLock();
 }
});
/* ═══ 后台播放保活: 静音 OscillatorNode 保持 AudioContext 活跃 ═══ */
/* Android WebView 在后台时可能暂停 <audio>, 但 AudioContext 一旦被系统视为
   活跃音频源就不容易被暂停。用一个静音振荡器持续运行来"占住"音频通道。 */
var _bgAudioCtx=null,_bgOsc=null,_bgGain=null;
function startBgKeepAlive(){
 try{
  if(_bgAudioCtx)return;
  var AC=window.AudioContext||window.webkitAudioContext;
  if(!AC)return;
  _bgAudioCtx=new AC();
  _bgOsc=_bgAudioCtx.createOscillator();
  _bgGain=_bgAudioCtx.createGain();
  _bgGain.gain.value=0; /* 完全静音 */
  _bgOsc.connect(_bgGain);
  _bgGain.connect(_bgAudioCtx.destination);
  _bgOsc.start();
 }catch(e){}
}
/* 后台持续检测并恢复播放 */
setInterval(function(){
 if(document.hidden&&S.playing&&audio.paused&&!window.__micHold){
  audio.play().catch(function(){});
 }
},2000);
/* 页面即将关闭/导航离开: 同步进度 + 尝试保持播放 */
window.addEventListener('pagehide',function(){
 if(audio.duration>0){
  try{pushControl({action:'seek',position:Math.round(audio.currentTime*1000)})}catch(e){}
 }
 /* 退出页面前同步尝试保持播放 */
 if(_shouldPlay&&audio.paused&&!window.__micHold){
  audio.play().catch(function(){});
 }
});
window.addEventListener('beforeunload',function(){
