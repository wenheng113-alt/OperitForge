<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>一起听</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:#141216;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;-webkit-user-select:none;user-select:none}
#bg{position:fixed;top:-60px;left:-60px;right:-60px;bottom:-60px;background:#2a2226 center/cover no-repeat;-webkit-filter:blur(55px) brightness(.42) saturate(1.15);filter:blur(55px) brightness(.42) saturate(1.15);z-index:0}
#bgmask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(10,8,12,.18);z-index:0}
#app{position:relative;z-index:1;height:100%;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;color:#fff}
#topbar{height:52px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:0 6px;-webkit-flex-shrink:0;flex-shrink:0}
.tbtn{width:42px;height:42px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer}
.tbtn svg{width:23px;height:23px;fill:#fff}
/* 顶栏中间双行: 歌名 + 歌手 */
#toptitle{-webkit-flex:1;flex:1;text-align:center;min-width:0}
#ttname{font-size:16px;font-weight:600;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.4);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#ttartist{font-size:11px;color:rgba(255,255,255,.55);margin-top:2px;text-shadow:0 1px 4px rgba(0,0,0,.35);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* 头像区: 开场从两侧拉拢到中央靠拢 */
#avatars{position:relative;height:106px;-webkit-flex-shrink:0;flex-shrink:0}
.avatar{position:absolute;top:14px;width:52px;height:52px;border-radius:50%;background-color:#3c3640;background-size:cover;background-position:center;background-repeat:no-repeat;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;font-size:26px;box-shadow:0 6px 22px rgba(0,0,0,.5);border:2px solid rgba(255,255,255,.85)}
.avatar.me{left:calc(50% - 48px);z-index:2;background-image:url('/avatar/me');background-size:cover;background-position:center;-webkit-animation:fromL .8s cubic-bezier(.2,.85,.3,1.08) .1s backwards;animation:fromL .8s cubic-bezier(.2,.85,.3,1.08) .1s backwards}
.avatar.by{left:calc(50% - 6px);z-index:3;-webkit-animation:fromR .8s cubic-bezier(.2,.85,.3,1.08) .1s backwards;animation:fromR .8s cubic-bezier(.2,.85,.3,1.08) .1s backwards}
@keyframes fromL{from{opacity:0;transform:translateX(-56vw)}to{opacity:1;transform:none}}
@-webkit-keyframes fromL{from{opacity:0;-webkit-transform:translateX(-56vw)}to{opacity:1;-webkit-transform:none}}
@keyframes fromR{from{opacity:0;transform:translateX(56vw)}to{opacity:1;transform:none}}
@-webkit-keyframes fromR{from{opacity:0;-webkit-transform:translateX(56vw)}to{opacity:1;-webkit-transform:none}}
.avlabel{display:none}
#distance{position:absolute;top:76px;height:14px;left:0;right:0;text-align:center;font-size:10.5px;color:rgba(255,255,255,.45);cursor:pointer}
.bubble{position:absolute;top:-34px;max-width:140px;background:#fff;color:#222;font-size:12px;line-height:1.35;padding:6px 10px;border-radius:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .25s;box-shadow:0 2px 10px rgba(0,0,0,.3);pointer-events:none;z-index:9}
.bubble.show{opacity:1}
.bubble:after{content:'';position:absolute;bottom:-5px;left:50%;margin-left:-5px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:5px solid #fff}
#myBubble{left:calc(50% - 128px)}
#byBubble{left:calc(50% - 22px)}
/* 黑胶 */
/* 舞台层: 唱片与歌词叠放于此, 切换时交叉过渡互不抢空间 */
#stage{position:relative;-webkit-flex:1;flex:1;min-height:190px}
#vinylwrap{position:absolute;left:0;top:0;right:0;bottom:0;opacity:1;visibility:visible;-webkit-transform:none;transform:none;-webkit-transition:opacity .32s ease,-webkit-transform .32s ease,transform .32s ease,visibility .32s;transition:opacity .32s ease,transform .32s ease,visibility .32s}
#vinylwrap.off{opacity:0;visibility:hidden;-webkit-transform:scale(.92);transform:scale(.92);pointer-events:none}
#vinylbox{position:absolute;top:50%;left:50%;width:68vw;height:68vw;max-width:300px;max-height:300px;margin-left:-34vw;margin-top:-34vw}
@media (min-width:442px){#vinylbox{margin-left:-150px;margin-top:-150px}}
#vinyl{position:relative;width:100%;height:100%;border-radius:50%;animation:spin 20s linear infinite paused;-webkit-animation:spin 20s linear infinite paused;will-change:transform}
#vinyl.playing{-webkit-animation-play-state:running;animation-play-state:running}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@-webkit-keyframes spin{from{-webkit-transform:rotate(0deg)}to{-webkit-transform:rotate(360deg)}}
.diskimg{position:absolute;top:0;left:0;width:100%;height:100%;border-radius:50%;display:block}
#cover{position:absolute;top:21.5%;left:21.5%;width:57%;height:57%;border-radius:50%;object-fit:cover;visibility:hidden}
/* 歌曲信息: 唱片下方 + 右侧三图标 */
#songrow{position:absolute;left:0;right:0;bottom:30px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:flex-end;justify-content:flex-end;padding:0 44px 0 18px}
#songinfo{display:none;-webkit-flex:1;flex:1;min-width:0;padding-right:8px}
#snameline{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;overflow:hidden}
#songname{font-size:17px;font-weight:600;color:#fff;text-shadow:0 1px 5px rgba(0,0,0,.35);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.viptag{-webkit-flex-shrink:0;flex-shrink:0;margin-left:6px;padding:0 4px;height:14px;line-height:14px;border:1px solid #dcb87c;border-radius:3px;color:#e3bf83;font-size:9px;font-style:normal}
#artist{font-size:12px;color:rgba(255,255,255,.55);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#songacts{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-flex-shrink:0;flex-shrink:0;-webkit-transform:translateY(24px);transform:translateY(24px)}
.sact{width:44px;height:44px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer;position:relative}
.sact svg{width:22px;height:22px;fill:none;stroke:rgba(255,255,255,.85);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round}
.sact.on svg{fill:#ec4141;stroke:#ec4141}
.badge{position:absolute;top:1px;right:1px;min-width:15px;height:15px;background:#ec4141;color:#fff;font-size:10px;line-height:15px;border-radius:8px;text-align:center;display:none;padding:0 3px}
.badge.show{display:block}
.mtab .badge{top:-4px;right:-2px}
/* 歌词与进度 */
#lyricline{position:absolute;left:0;right:0;bottom:4px;text-align:center;font-size:13px;color:rgba(255,255,255,.82);height:22px;line-height:22px;padding:0 30px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-shadow:0 1px 4px rgba(0,0,0,.4)}
/* 歌词面板: 点唱片切换显示, 网易云式滚动歌词 */
#lyrview{position:absolute;left:0;top:0;right:0;bottom:0;overflow:hidden;-webkit-mask-image:-webkit-linear-gradient(top,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(top,transparent,#000 12%,#000 88%,transparent);opacity:0;visibility:hidden;-webkit-transform:translateY(24px);transform:translateY(24px);-webkit-transition:opacity .32s ease,-webkit-transform .32s ease,transform .32s ease,visibility .32s;transition:opacity .32s ease,transform .32s ease,visibility .32s;pointer-events:none}
#lyrview.on{opacity:1;visibility:visible;-webkit-transform:none;transform:none;pointer-events:auto}
#lyrscroll{position:absolute;left:0;right:0;top:0;padding:40% 24px;will-change:transform;transition:-webkit-transform .35s,transform .35s}
.lrl{position:relative;font-size:15px;line-height:1.5;color:rgba(255,255,255,.42);margin:14px 0;text-align:center;text-shadow:0 1px 4px rgba(0,0,0,.35);transition:color .25s,-webkit-transform .25s,transform .25s;cursor:pointer}
.lrl.cur{color:#fff;font-size:17px;font-weight:600;text-shadow:0 1px 6px rgba(0,0,0,.5)}
.lptx{display:inline}
/* 浏览态浮层: 官方形态 时间──线──播放键 横在歌词中部 */
#lyrhint{position:absolute;left:24px;right:24px;top:50%;margin-top:-16px;display:none;-webkit-align-items:center;align-items:center;z-index:6}
#lyrhinttx{font-size:13px;color:rgba(255,255,255,.9);width:40px;text-align:left;-webkit-flex-shrink:0;flex-shrink:0;text-shadow:0 1px 4px rgba(0,0,0,.4)}
#lyrhintline{-webkit-flex:1;flex:1;height:2px;background:rgba(255,255,255,.3);border-radius:1px;margin:0 12px}
#lyrhintbtn{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.18);display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;-webkit-flex-shrink:0;flex-shrink:0}
#lyrhintbtn svg{width:15px;height:15px;fill:#fff}
#progressrow{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:6px 18px 0;-webkit-flex-shrink:0;flex-shrink:0}
.time{font-size:11px;color:rgba(255,255,255,.5);width:38px}
.time.dur{text-align:right}
#bar{position:relative;-webkit-flex:1;flex:1;height:24px;cursor:pointer}
#bartrack{position:absolute;top:11px;left:0;right:0;height:2px;background:rgba(255,255,255,.22);border-radius:1px}
#barfill{position:absolute;top:11px;left:0;width:0;height:2px;background:#fff;border-radius:1px}
#barthumb{position:absolute;top:7px;left:-6px;width:10px;height:10px;border-radius:50%;background:#a6a6a6;box-shadow:0 1px 4px rgba(0,0,0,.4);z-index:2}
/* 控制栏: 循环/上一首/播放/下一首/列表 */
#controls{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;padding:8px 0 6px;-webkit-flex-shrink:0;flex-shrink:0}
.ctl{width:48px;height:48px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer}
.ctl svg{width:22px;height:22px;fill:rgba(255,255,255,.92)}
#modebtn{position:relative}
#modebtn #modeone{display:none;position:absolute;top:6px;right:8px;font-size:8px;font-weight:700;color:#fff;line-height:1}
#playbtn{width:62px;height:62px;margin:0 18px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer}
#playbtn svg{width:56px;height:56px;fill:#fff}
/* 底部胶囊tab */
#bottombar{position:fixed;left:0;right:0;bottom:0;z-index:35;height:64px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;padding-bottom:6px;background:linear-gradient(to top,rgba(15,13,16,.55),rgba(15,13,16,0))}
#bbspacer{height:64px;-webkit-flex-shrink:0;flex-shrink:0}
#modetabs{display:-webkit-flex;display:flex;background:rgba(255,255,255,.16);border-radius:19px;padding:3px}
.mtab{position:relative;width:60px;height:32px;border-radius:16px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer}
.mtab svg{width:17px;height:17px;fill:rgba(255,255,255,.85)}
.mtab.on{background:rgba(255,255,255,.94)}
.mtab.on svg{fill:#222}
#bmore{position:absolute;right:10px;bottom:12px}
#modelpanel{position:fixed;left:0;right:0;bottom:0;top:25%;background:#1c181e;z-index:44;border-radius:16px 16px 0 0;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-transform:translateY(103%);transform:translateY(103%);opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:-webkit-transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s;transition:transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s}
#modelpanel.open{-webkit-transform:translateY(0);transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
#modelmask{position:fixed;left:0;right:0;top:0;bottom:75%;z-index:43;background:transparent;display:block;opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:opacity .3s ease,visibility .3s;transition:opacity .3s ease,visibility .3s}
#modelmask.open{opacity:1;visibility:visible;pointer-events:auto}
#modelhead{flex-shrink:0;padding:14px 16px 10px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center}
#modeltitle{font-size:15px;font-weight:600;color:#fff}
#modelclose{margin-left:auto;font-size:13px;color:#ec4141;cursor:pointer;padding:4px 8px}
#modelbody{flex:1;overflow-y:auto;padding:16px}
#qrpanel{position:fixed;left:0;right:0;bottom:0;top:25%;background:#1c181e;z-index:46;border-radius:16px 16px 0 0;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-transform:translateY(103%);transform:translateY(103%);opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:-webkit-transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .28s;transition:transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .28s}
#qrpanel.open{-webkit-transform:translateY(0);transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
#qrmask{position:fixed;left:0;right:0;top:0;bottom:75%;z-index:45;background:transparent;display:block;opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:opacity .3s ease,visibility .3s;transition:opacity .3s ease,visibility .3s}
#qrmask.open{opacity:1;visibility:visible;pointer-events:auto}
#qrhead{flex-shrink:0;padding:14px 16px 10px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center}
#qrtitle{font-size:15px;font-weight:600;color:#fff}
#qrclose{margin-left:auto;font-size:13px;color:#ec4141;cursor:pointer;padding:4px 8px}
#qrbody{flex:1;overflow-y:auto;padding:16px;text-align:center}
#qrbox{position:relative;width:220px;height:220px;margin:8px auto;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:hidden}
#qrbox img{width:200px;height:200px;display:block}
#qrspin{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);color:#666;font-size:12px}
#qrstatus{margin-top:10px;font-size:12px;color:rgba(255,255,255,.6)}
#qrtabs{flex-shrink:0;display:flex;border-bottom:1px solid rgba(255,255,255,.07)}
.qrtab{flex:1;text-align:center;padding:10px 0;font-size:13px;color:rgba(255,255,255,.5);cursor:pointer;position:relative;-webkit-tap-highlight-color:transparent}
.qrtab.on{color:#fff}
.qrtab.on:after{content:'';position:absolute;left:50%;bottom:0;width:36px;height:2px;background:#ec4141;transform:translateX(-50%);-webkit-transform:translateX(-50%);border-radius:2px}
#qrpaneSms{text-align:left}
#smsStatus{margin-top:8px;font-size:12px;color:rgba(255,255,255,.5);line-height:1.6;text-align:left;min-height:16px}
.mfield{margin-bottom:14px}
.mfield label{display:block;font-size:12px;color:rgba(255,255,255,.5);margin-bottom:5px}
.mfield input,.mfield textarea{width:100%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:10px 12px;color:#fff;font-size:14px;outline:none;-webkit-appearance:none}
.mfield input:focus,.mfield textarea:focus{border-color:#ec4141}
.mfield textarea{resize:none;height:60px;line-height:1.4}
.srcgrp{border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:8px 10px;margin-bottom:8px;background:rgba(255,255,255,.02)}
.srcgrph{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,.72);margin-bottom:8px;font-weight:600}
.srcgrpi{font-size:14px}
.srcrow{display:flex;align-items:flex-start;gap:8px;margin-bottom:6px}
.srcrow:last-child{margin-bottom:0}
.srcrowl{flex:0 0 34px;font-size:11px;color:rgba(255,255,255,.4);padding-top:9px}
.srcrow input,.srcrow textarea{flex:1;min-width:0}
.srcpills{display:flex;gap:8px}
.apilist{margin-bottom:8px}
.apiitem{display:flex;align-items:center;gap:8px;padding:8px 10px;margin-bottom:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;font-size:12px}
.apiitem .apinm{flex:0 0 auto;font-weight:600;color:rgba(255,255,255,.85);max-width:32%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.apiitem .apiurl{flex:1;min-width:0;color:rgba(255,255,255,.4);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}
.apiitem .apikey{flex:0 0 auto;font-size:10px;color:#7fd18a;border:1px solid rgba(127,209,138,.4);border-radius:4px;padding:1px 5px}
.apiitem .apidel{flex:0 0 auto;color:rgba(255,255,255,.4);cursor:pointer;padding:0 2px;font-size:14px}
.apiitem .apidel:hover{color:#ec4141}
.apiempty{font-size:11px;color:rgba(255,255,255,.3);padding:6px 2px}
.apiaddbtn{width:100%;padding:8px 0;font-size:12px;border-radius:8px;background:rgba(236,65,65,.12);border:1px dashed rgba(236,65,65,.5);color:#ec6a6a;cursor:pointer}
.apiaddbtn:hover{background:rgba(236,65,65,.2)}
.apiform{margin-top:8px;padding:8px;border:1px solid rgba(255,255,255,.1);border-radius:8px;background:rgba(255,255,255,.02)}
.apibtns{display:flex;gap:8px;margin-top:8px}
.apibtn{flex:1;padding:8px 0;font-size:12px;border-radius:8px;border:none;background:#ec4141;color:#fff;cursor:pointer}
.apibtn.ghost{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7)}
.srcpill{flex:1;text-align:center;padding:9px 0;font-size:13px;border-radius:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.7);cursor:pointer;transition:background .2s,border-color .2s,color .2s}
.srcpill.active{background:rgba(236,65,65,.18);border-color:#ec4141;color:#fff}
.msave{display:block;width:100%;padding:12px;background:#ec4141;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;margin-top:6px}
.msave:active{opacity:.85}
.mstatus{font-size:12px;color:rgba(255,255,255,.4);text-align:center;margin-top:8px}
.mclear{display:block;width:100%;padding:11px;background:transparent;border:1px solid rgba(236,65,65,.4);border-radius:10px;font-size:14px;color:#ec4141;cursor:pointer;margin-top:12px}
.mclear:active{background:rgba(236,65,65,.12)}
/* 聊天面板 */
/* 播放列表抽屉: 官方式底部弹出 */
#plpanel{position:fixed;left:0;right:0;bottom:0;top:38%;background:#1c181e;z-index:40;border-radius:16px 16px 0 0;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-transform:translateY(103%);transform:translateY(103%);opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:-webkit-transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s;transition:transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s}
#plpanel.open{-webkit-transform:translateY(0);transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
#plmask{position:fixed;left:0;right:0;top:0;bottom:62%;z-index:39;background:transparent;display:block;opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:opacity .3s ease,visibility .3s;transition:opacity .3s ease,visibility .3s}
#plmask.open{opacity:1;visibility:visible;pointer-events:auto}
#plhead{-webkit-flex-shrink:0;flex-shrink:0;padding:14px 16px 10px;border-bottom:1px solid rgba(255,255,255,.07);display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center}
#pltitle{font-size:15px;font-weight:600;color:#fff}
#plcount{font-size:11px;color:rgba(255,255,255,.4);margin-left:6px;font-weight:400}
#plclear{-webkit-flex:1;flex:1;text-align:right;font-size:12px;color:#ec4141;padding:6px 0 6px 8px;cursor:pointer}
#plbody{-webkit-flex:1;flex:1;overflow-y:auto;padding:4px 0 16px}
#pltabs{display:-webkit-flex;display:flex;gap:8px;padding:8px 16px 10px;border-bottom:1px solid rgba(255,255,255,.07);-webkit-flex-shrink:0;flex-shrink:0}
#pltabs .pltab{font-size:12px;color:rgba(255,255,255,.5);padding:5px 14px;border-radius:20px;cursor:pointer;-webkit-user-select:none;user-select:none;transition:all .2s}
#pltabs .pltab:hover{color:#fff}
#pltabs .pltab.on{color:#fff;background:rgba(236,65,65,.85)}
#commentpanel{position:fixed;left:0;right:0;bottom:0;top:38%;background:#1c181e;z-index:42;border-radius:16px 16px 0 0;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-transform:translateY(103%);transform:translateY(103%);opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:-webkit-transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s;transition:transform .34s cubic-bezier(.22,.8,.34,1),opacity .28s ease,visibility .34s}
#commentpanel.open{-webkit-transform:translateY(0);transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
#commentmask{position:fixed;left:0;right:0;top:0;bottom:62%;z-index:41;background:transparent;display:block;opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:opacity .3s ease,visibility .3s;transition:opacity .3s ease,visibility .3s}
#commentmask.open{opacity:1;visibility:visible;pointer-events:auto}
#commenthead{flex-shrink:0;padding:14px 16px 10px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center}
#commenttitle{font-size:15px;font-weight:600;color:#fff}#commentcount{font-size:11px;color:rgba(255,255,255,.4);margin-left:6px;font-weight:400}
#commentbody{flex:1;overflow-y:auto;padding:5px 16px 18px}.commentrow{padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06)}.commentuser{font-size:12px;color:#d9a7b1;margin-bottom:5px}.commenttext{font-size:14px;line-height:1.55;color:rgba(255,255,255,.88);word-break:break-word}
.plrow{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:9px 16px;cursor:pointer}
.plrow.cur .plnm{color:#ec4141}
.plrow.played .plnm{color:rgba(255,255,255,.38)}
.plrow.played .plar{color:rgba(255,255,255,.22)}
.plrow.played .plidx{color:#ec4141}
.plidx{width:26px;font-size:13px;color:rgba(255,255,255,.35);-webkit-flex-shrink:0;flex-shrink:0}
.plinfo{-webkit-flex:1;flex:1;min-width:0;margin-right:8px}
.plnm{font-size:14px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.plar{font-size:11px;color:rgba(255,255,255,.45);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pldel{width:34px;height:34px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;-webkit-flex-shrink:0;flex-shrink:0;color:rgba(255,255,255,.35);cursor:pointer}
/* 聊天整页视图: 从右往左渐显 */
#chatpage{position:fixed;left:0;right:0;top:0;bottom:0;background:#2b2926;z-index:30;padding-bottom:70px;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;opacity:0;pointer-events:none;-webkit-transform:translateX(30px);transform:translateX(30px);transition:opacity .3s ease,-webkit-transform .3s cubic-bezier(.16,1,.3,1);transition:opacity .3s ease,transform .3s cubic-bezier(.16,1,.3,1)}
#cvbg{position:absolute;left:0;top:0;right:0;bottom:0;background:#2a2226 center/cover no-repeat;-webkit-filter:blur(55px) brightness(.42) saturate(1.15);filter:blur(55px) brightness(.42) saturate(1.15);z-index:0}
#cvtop,#cvinfo,#msgs,#inputrow{position:relative;z-index:1}
#chatpage.on{opacity:1;pointer-events:auto;-webkit-transform:none;transform:none}
#cvtop{-webkit-flex-shrink:0;flex-shrink:0;padding:28px 16px 4px;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-align-items:center;align-items:center}
#cavs{height:52px;margin-bottom:10px;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.cav{position:relative;width:52px;height:52px;border-radius:50%;background-color:#3c3640;background-size:cover;background-position:center;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;font-size:24px;box-shadow:0 4px 16px rgba(0,0,0,.4)}
.cav:first-child{margin-right:12px}
#cvsub{font-size:12.5px;color:rgba(255,255,255,.55)}
#cvinfo{-webkit-flex-shrink:0;flex-shrink:0;padding:14px 18px 6px;display:-webkit-flex;display:flex;-webkit-align-items:flex-end;align-items:flex-end;cursor:pointer}
#cvmeta{-webkit-flex:1;flex:1;min-width:0}
#cvline{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;min-width:0}
#cvname{font-size:19px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:66vw}
.cvip{-webkit-flex-shrink:0;flex-shrink:0;margin-left:7px;padding:0 4px;height:15px;line-height:15px;border:1px solid rgba(255,255,255,.4);border-radius:3px;color:rgba(255,255,255,.7);font-size:9px;font-style:normal;font-weight:500}
#cvartist{margin-top:3px;font-size:12.5px;color:rgba(255,255,255,.5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#cvmore{width:40px;height:40px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;-webkit-flex-shrink:0;flex-shrink:0}
#cvright{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-flex-shrink:0;flex-shrink:0;padding-bottom:4px}
#cvheart{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;margin-right:8px}
#cvheart svg{width:19px;height:19px;fill:#e8443f}
#cvheartn{font-size:11px;color:rgba(255,255,255,.8);margin-left:2px;font-weight:500}
#cvmore svg{width:22px;height:22px;fill:none;stroke:rgba(255,255,255,.75);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
#msgs{-webkit-flex:1;flex:1;overflow-y:auto;padding:10px 14px 6px}
.mrow{display:-webkit-flex;display:flex;-webkit-align-items:flex-start;align-items:flex-start;margin-bottom:12px}
.mrow.me{-webkit-flex-direction:row-reverse;flex-direction:row-reverse}
.mav{width:34px;height:34px;border-radius:50%;background:#3c3640;-webkit-flex-shrink:0;flex-shrink:0;object-fit:cover;margin-top:2px}
.mrow.ai .mav{margin-right:9px}
.mrow.me .mav{margin-left:9px}
.mrow .txt{max-width:72%;padding:10px 14px;border-radius:14px;font-size:14.5px;line-height:1.5;word-break:break-all;color:rgba(255,255,255,.92)}
.mrow.ai .txt{background:#3a3835}
.mrow.me .txt{background:#3a3835}
 /* 推荐歌曲卡片 */
 .recCard{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:8px 10px;margin-bottom:6px;background:#332e2c;border-radius:10px;cursor:pointer;transition:background .2s}
 .recCard:active{background:#3d3835}
 .recCardPlay{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#ec4141,#f06292);display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;-webkit-flex-shrink:0;flex-shrink:0;margin-right:10px}
 .recCardPlay svg{width:14px;height:14px}
 .recCardInfo{-webkit-flex:1;flex:1;min-width:0}
 .recCardName{font-size:13px;color:rgba(255,255,255,.92);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .recCardArtist{font-size:11px;color:rgba(255,255,255,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
 /* 歌单确认卡片 */
 .plCard{background:linear-gradient(145deg,#3a3430,#2e2926);border:1px solid rgba(236,65,65,.35);border-radius:12px;padding:10px 12px;margin-bottom:6px}
 .plCardHead{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;margin-bottom:8px}
 .plCardIcon{width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#ec4141,#f06292);display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;margin-right:10px;flex-shrink:0}
 .plCardIcon svg{width:18px;height:18px;fill:#fff}
 .plCardTitle{font-size:13px;color:rgba(255,255,255,.95);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .plCardSub{font-size:11px;color:rgba(255,255,255,.45);margin-top:2px}
 .plCardSongs{font-size:11px;color:rgba(255,255,255,.5);line-height:1.6;margin-bottom:9px;max-height:66px;overflow:hidden}
 .plCardBtns{display:-webkit-flex;display:flex;gap:8px}
 .plBtn{-webkit-flex:1;flex:1;text-align:center;padding:9px 0;border-radius:9px;font-size:13px;cursor:pointer;transition:opacity .2s}
 .plBtn:active{opacity:.75}
 .plBtnOk{background:linear-gradient(135deg,#ec4141,#f06292);color:#fff;font-weight:600}
 .plBtnNo{background:#3a3835;color:rgba(255,255,255,.6)}
 .plCardDone{font-size:12px;color:rgba(255,255,255,.4);text-align:center;padding:6px 0}
#inputrow{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:8px 14px 10px;background:transparent}
#inputwrap{-webkit-flex:1;flex:1;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;background:#3a3835;border-radius:21px;padding:0 12px 0 16px;height:42px;min-width:0}
#msginput{-webkit-flex:1;flex:1;background:transparent;border:0;padding:10px 0;color:#fff;font-size:14.5px;outline:none;min-width:60px;-webkit-user-select:text;user-select:text}
#msginput::placeholder{color:rgba(255,255,255,.35)}
#sendbtn{margin-left:10px;background:#3a3835;border:0;padding:0;width:42px;height:42px;border-radius:50%;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;cursor:pointer;-webkit-flex-shrink:0;flex-shrink:0;transition:background .2s}
#sendbtn svg{width:19px;height:19px;fill:rgba(255,255,255,.85)}
/* 特效层 */
#taphint{position:fixed;left:50%;margin-left:-105px;bottom:150px;width:210px;background:rgba(236,65,65,.95);color:#fff;font-size:13px;text-align:center;padding:11px 12px;border-radius:22px;z-index:65;display:none;cursor:pointer;box-shadow:0 4px 18px rgba(0,0,0,.4)}
#taphint.show{display:block}
#fxlayer{position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:50;overflow:hidden}
.ltl{position:absolute;top:36%;width:90px;height:90px;margin-left:-45px;pointer-events:none}
.popheart{position:absolute;top:34%;font-size:26px;animation:poph 1.1s ease-out forwards}
@keyframes poph{0%{opacity:0;transform:scale(.4)}25%{opacity:1}100%{opacity:0;transform:translateY(-80px) scale(1.4)}}
/* 换碟动画已改为JS轨道推挤(见loadSong), 此处不再使用keyframes */

.rain{position:absolute;top:-30px;font-size:20px;animation:rainfall 2.6s linear forwards}
@keyframes rainfall{to{transform:translateY(110vh) rotate(320deg)}}
/* 搜索面板 */
#searchpanel{position:fixed;top:0;left:0;right:0;bottom:0;background:#241f26;z-index:60;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-transform:translateX(9%);transform:translateX(9%);opacity:0;visibility:hidden;pointer-events:none;-webkit-transition:-webkit-transform .36s cubic-bezier(.22,.8,.34,1),opacity .3s ease,visibility .36s;transition:transform .36s cubic-bezier(.22,.8,.34,1),opacity .3s ease,visibility .36s}
#searchpanel.open{-webkit-transform:translateX(0);transform:translateX(0);opacity:1;visibility:visible;pointer-events:auto}
#sphead{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:10px 12px;background:transparent;border-bottom:1px solid rgba(255,255,255,.07)}
#spback{width:36px;height:36px;cursor:pointer;-webkit-flex-shrink:0;flex-shrink:0}
#spback svg{width:20px;height:20px;fill:rgba(255,255,255,.85)}
#spinput{-webkit-flex:1;flex:1;background:rgba(255,255,255,.09);border:0;border-radius:8px;padding:9px 12px;font-size:14px;color:#fff;outline:none;margin:0 8px}
#spinput::-webkit-input-placeholder,#spinput::placeholder{color:rgba(255,255,255,.32)}
#spgo{background:none;border:0;color:#ec4141;font-size:14.5px;cursor:pointer;padding:6px 4px;-webkit-flex-shrink:0;flex-shrink:0}
#spresults{-webkit-flex:1;flex:1;overflow-y:auto;padding:4px 0 20px}
.spempty{text-align:center;color:rgba(255,255,255,.3);font-size:13px;padding-top:90px;line-height:1.8}
.spitem{display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;padding:11px 14px;cursor:pointer;background:transparent}
.spitem:active{background:rgba(255,255,255,.07)}
/* 音源切换 */
#sptabs{display:-webkit-flex;display:flex;gap:0;padding:0 14px 8px;border-bottom:1px solid rgba(255,255,255,.06)}
.sptab{-webkit-flex:1;flex:1;text-align:center;padding:8px 0;font-size:13px;color:rgba(255,255,255,.4);cursor:pointer;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}
.sptab.active{color:#ec4141;border-bottom-color:#ec4141}
.spidx{width:26px;font-size:14px;color:rgba(255,255,255,.35);text-align:center;-webkit-flex-shrink:0;flex-shrink:0}
.spinfo{-webkit-flex:1;flex:1;overflow:hidden;margin-right:8px}
.spnm{font-size:15px;color:rgba(255,255,255,.92);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spar{font-size:11.5px;color:rgba(255,255,255,.45);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spplay{width:34px;height:34px;display:-webkit-flex;display:flex;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center;-webkit-flex-shrink:0;flex-shrink:0}
.spplay svg{width:16px;height:16px;fill:#ec4141}
/* Toast 与进场动画时序: 头像拉拢(.1-.9s) → 唱片弹出(.3s) → 下半部上滑(.5s) → 唱针落下(.8s) */
#toast{position:fixed;bottom:130px;left:50%;margin-left:-100px;width:200px;background:rgba(0,0,0,.82);color:#fff;font-size:13px;text-align:center;padding:10px 12px;border-radius:10px;z-index:70;opacity:0;pointer-events:none;transition:opacity .25s}
#toast.show{opacity:1}
/* ════ 装扮库 CSS ════ */
/* 装扮面板 */
#dressMask{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:80;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
#dressMask.show{opacity:1;visibility:visible}
#dressPanel{position:fixed;left:0;right:0;bottom:0;background:#1a1620;z-index:81;border-radius:20px 20px 0 0;max-height:80vh;display:flex;flex-direction:column;transform:translateY(100%);transition:transform .35s cubic-bezier(.22,.8,.34,1);box-shadow:0 -4px 30px rgba(0,0,0,.5)}
#dressPanel.show{transform:translateY(0)}
#dressHead{flex-shrink:0;padding:16px 16px 10px;display:flex;align-items:center;border-bottom:1px solid rgba(255,255,255,.06)}
#dressTitle{font-size:16px;font-weight:700;color:#fff;flex:1;text-align:center}
#dressClose{width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.5);font-size:20px;cursor:pointer}
#dressTabs{display:flex;flex-shrink:0;padding:8px 12px;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
#dressTabs::-webkit-scrollbar{display:none}
.dressTab{flex-shrink:0;padding:6px 16px;border-radius:16px;font-size:13px;color:rgba(255,255,255,.5);background:rgba(255,255,255,.08);cursor:pointer;white-space:nowrap;transition:all .2s}
.dressTab.active{color:#fff;background:#ec4141}
#dressBody{flex:1;overflow-y:auto;padding:10px 12px 20px;-webkit-overflow-scrolling:touch}
.dressGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.dressItem{position:relative;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:1/1;background:rgba(255,255,255,.06);border:2px solid transparent;transition:border-color .2s,transform .15s}
.dressItem:active{transform:scale(.95)}
.dressItem.active{border-color:#ec4141}
.dressPreview{width:100%;height:100%;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.dressPreview svg{width:80%;height:80%}
.dressLabel{position:absolute;bottom:0;left:0;right:0;font-size:10px;color:rgba(255,255,255,.9);text-align:center;padding:3px 0;background:linear-gradient(transparent,rgba(0,0,0,.7));line-height:1.2}
.dressCheck{position:absolute;top:4px;right:4px;width:18px;height:18px;border-radius:50%;background:#ec4141;display:none;align-items:center;justify-content:center;font-size:11px;color:#fff}
.dressItem.active .dressCheck{display:flex}
/* 唱片盘片替换 - 通过JS动态替换diskimg的src */
body[data-vinyl=""] .diskimg,body[data-vinyl] .diskimg{transition:opacity .3s}
/* 唱片光晕 */
body[data-vinyl="glow1"] #vinylbox{filter:drop-shadow(0 0 12px rgba(255,180,80,.5))}
body[data-vinyl="glow2"] #vinylbox{filter:drop-shadow(0 0 12px rgba(80,180,255,.5))}
body[data-vinyl="glow3"] #vinylbox{filter:drop-shadow(0 0 14px rgba(255,100,150,.5))}
body[data-vinyl="glow4"] #vinylbox{filter:drop-shadow(0 0 14px rgba(180,100,255,.5))}
body[data-vinyl="glow5"] #vinylbox{filter:drop-shadow(0 0 16px rgba(255,255,255,.4))}
/* 背景主题 - 自定义上传图片 */
body[data-bgtheme="custom"] #bg{background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important}
body[data-bgtheme="custom"] #cvbg{background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important}
body[data-bgtheme="custom"] #bgmask{background:rgba(0,0,0,.15)!important}
/* 预设背景保留 */
body[data-bgtheme="bg1"] #bg{background:#1a1a2e!important}
body[data-bgtheme="bg1"] #bgmask{background:rgba(10,10,30,.3)!important}
body[data-bgtheme="bg2"] #bg{background:#2d1b3d!important}
body[data-bgtheme="bg2"] #bgmask{background:rgba(20,10,40,.3)!important}
body[data-bgtheme="bg3"] #bg{background:#1b3d2e!important}
body[data-bgtheme="bg3"] #bgmask{background:rgba(10,40,30,.3)!important}
body[data-bgtheme="bg4"] #bg{background:#3d1b1b!important}
body[data-bgtheme="bg4"] #bgmask{background:rgba(40,10,10,.3)!important}
body[data-bgtheme="bg5"] #bg{background:#1b2d3d!important}
body[data-bgtheme="bg5"] #bgmask{background:rgba(10,30,50,.3)!important}
/* 上传按钮样式 */
.dressUploadBtn{grid-column:span 3;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border-radius:12px;background:linear-gradient(135deg,rgba(236,65,65,.15),rgba(236,65,65,.05));border:1.5px dashed rgba(236,65,65,.5);cursor:pointer;color:#ec4141;font-size:14px;font-weight:600;transition:all .2s}
.dressUploadBtn:active{transform:scale(.97);background:rgba(236,65,65,.2)}
.dressUploadBtn svg{width:18px;height:18px}
.dressCustomItem{position:relative;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:1/1;background:rgba(255,255,255,.06);border:2px solid transparent;transition:border-color .2s,transform .15s}
.dressCustomItem:active{transform:scale(.95)}
.dressCustomItem.active{border-color:#ec4141}
.dressDelBtn{position:absolute;top:4px;left:4px;width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;font-size:12px;color:#ff6b6b;z-index:2}
/* 背景模糊调节器 */
.dressBlurBar{padding:14px 16px;border-radius:12px;background:rgba(255,255,255,.06);display:flex;flex-direction:column;gap:8px;margin-top:10px}
.dressBlurBar label{font-size:13px;color:rgba(255,255,255,.7);display:flex;justify-content:space-between;align-items:center}
.dressBlurBar label span{color:#ec4141;font-weight:600}
.dressBlurBar input[type=range]{width:100%;height:4px;border-radius:2px;background:rgba(255,255,255,.15);-webkit-appearance:none;appearance:none;outline:none}
.dressBlurBar input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:18px;height:18px;border-radius:50%;background:#ec4141;cursor:pointer;box-shadow:0 2px 6px rgba(236,65,65,.4)}
.fxRow{display:flex;align-items:center;justify-content:space-between;padding:16px;border-radius:12px;background:rgba(255,255,255,.06);margin-top:6px}
.fxLabel{font-size:14px;color:#fff}
.fxSwitch{width:50px;height:28px;border-radius:14px;background:rgba(255,255,255,.2);position:relative;transition:background .25s;cursor:pointer;flex-shrink:0}
.fxSwitch.on{background:#ec4141}
.fxSwitch i{position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .25s}
.fxSwitch.on i{transform:translateX(22px)}
.fxHint{font-size:12px;color:rgba(255,255,255,.45);line-height:1.6;padding:12px 4px 0}
/* 粒子特效通过JS动态生成 */
.fadeD{animation:fadeD .45s ease-out backwards;-webkit-animation:fadeD .45s ease-out backwards}
@keyframes fadeD{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:none}}
.fadeU{animation:fadeU .5s ease-out .5s backwards;-webkit-animation:fadeU .5s ease-out .5s backwards}
@keyframes fadeU{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.vpop{animation:vpop .55s cubic-bezier(.3,1.2,.5,1) .3s backwards;-webkit-animation:vpop .55s cubic-bezier(.3,1.2,.5,1) .3s backwards}
@keyframes vpop{from{opacity:0;transform:scale(.86)}to{opacity:1;transform:none}}
</style>
</head>
<body>
<div id="bg"></div><div id="bgmask"></div>
<div id="app">
  <div id="topbar" class="fadeD">
    <div class="tbtn" id="backbtn"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8 5.8 21.3l2.4-7.4L2 9.4h7.6z"/></svg></div>
    <div id="toptitle"><div id="ttname">一起听</div><div id="ttartist"></div></div>
    <div class="tbtn" id="morebtn"><svg viewBox="0 0 24 24"><path d="M12 8a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z"/></svg></div>
  </div>
  <div id="avatars">
    <div class="avatar me" id="avme">🌙</div>
    <div class="avatar by" id="avby">🌸</div>
    <div id="distance">正在建立连接…</div>
    <div class="bubble" id="myBubble"></div>
    <div class="bubble" id="byBubble"></div>
  </div>
  <div id="stage">
  <div id="vinylwrap" class="vpop">
    <div id="vinylbox">
      <div id="vinyl">
        <img class="diskimg" src="/vendor/disk.png" alt="">
        <img id="cover" alt="">
      </div>
    </div>
  </div>
  <div id="songrow" class="fadeU">
    <div id="songinfo">
      <div id="snameline"><div id="songname">还没有歌曲</div><i class="viptag" id="viptag" style="display:none">VIP</i></div>
      <div id="artist">点右上角 ⋮ 搜一首，和好友一起听吧</div>
    </div>
    <div id="songacts">
      <div class="sact" id="likebtn"><svg viewBox="0 0 24 24"><path d="M12 20.2C8.6 17.4 3.5 13.7 3.5 9.1c0-2.5 2-4.6 4.5-4.6 1.6 0 3.1.8 4 2.1.9-1.3 2.4-2.1 4-2.1 2.5 0 4.5 2.1 4.5 4.6 0 4.6-5.1 8.3-8.5 11.1z"/></svg></div>
      <div class="sact" id="chatact"><svg viewBox="0 0 24 24"><path d="M12 4.2c4.6 0 8.3 3.2 8.3 7.2 0 4-3.7 7.2-8.3 7.2-.9 0-1.8-.1-2.6-.4l-3.9 1.6.9-3.2c-1.7-1.3-2.7-3.2-2.7-5.2 0-4 3.7-7.2 8.3-7.2z"/></svg><span class="badge" id="msgbadge"></span></div>
    </div>
  </div>
  <div id="lyricline" class="fadeU"></div>
  <div id="lyrview">
    <div id="lyrscroll"></div>
    <div id="lyrhint"><span id="lyrhinttx">00:00</span><div id="lyrhintline"></div><div id="lyrhintbtn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
  </div>
  </div>
  <div id="progressrow" class="fadeU">
    <span class="time" id="curtime">00:00</span>
    <div id="bar"><div id="bartrack"></div><div id="barfill"></div><div id="barthumb"></div></div>
    <span class="time dur" id="durtime">00:00</span>
  </div>
  <div id="controls" class="fadeU">
    <div class="ctl" id="modebtn"><svg viewBox="0 0 24 24" id="modesvg"><g id="mloop" fill="none" stroke="rgba(255,255,255,.92)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9a8 8 0 0 1 14-2.5"/><path d="M18 2v4.5h-4.5"/><path d="M20 15a8 8 0 0 1-14 2.5"/><path d="M6 22v-4.5h4.5"/></g><g id="mrand" fill="none" stroke="rgba(255,255,255,.92)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M16.5 4l3.5 3.5-3.5 3.5"/><path d="M20 7.5H10a5.5 5.5 0 0 0-5.5 5.5"/><path d="M7.5 20L4 16.5 7.5 13"/><path d="M4 16.5h10a5.5 5.5 0 0 0 5.5-5.5"/></g></svg><span id="modeone">1</span></div>
    <div class="ctl" id="prevbtn"><svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></div>
    <div id="playbtn"><svg id="playsvg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
    <div class="ctl" id="nextbtn"><svg viewBox="0 0 24 24"><path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z"/></svg></div>
<div class="ctl" id="listbtn"><svg viewBox="0 0 24 24"><path d="M3 6h13v2H3zm0 5h13v2H3zm0 5h9v2H3zm15-1.5l5 3-5 3z"/></svg></div>
  </div>
  <div id="bbspacer"></div>
</div>
<audio id="audio" preload="auto" playsinline webkit-playsinline></audio>
<div id="plmask"></div>
<div id="plpanel">
  <div id="plhead"><span id="pltitle">当前播放</span><span id="plcount"></span><span id="plclear">清空</span></div>
  <div id="pltabs"><span class="pltab on" data-tab="list">播放列表</span><span class="pltab" data-tab="fav">红心歌单</span></div>
  <div id="plbody"></div>
</div>
<div id="commentmask"></div>
<div id="commentpanel">
  <div id="commenthead"><span id="commenttitle">热门评论</span><span id="commentcount"></span></div>
  <div id="commentbody"></div>
</div>
<div id="modelmask"></div>
<div id="modelpanel">
  <div id="modelhead"><span id="modeltitle">设置</span><span id="modelclose">完成</span></div>
  <div id="modelbody">
    <div class="mfield"><label>API地址 (Endpoint)</label><input id="cfgEndpoint" placeholder="https://api.example.com/v1" autocomplete="off"></div>
    <div class="mfield"><label>API Key</label><input id="cfgApiKey" type="password" placeholder="sk-..." autocomplete="off"></div>
    <div class="mfield"><label>模型名</label><input id="cfgModel" placeholder="gpt-4o / glm-5.2 ..." autocomplete="off"></div>
    <div class="mfield"><label>系统提示词</label><textarea id="cfgPrompt" placeholder="你是一个温柔友善的AI助手..."></textarea></div>
    <div class="mfield"><label>默认音源（搜索 / 点歌使用的音乐平台）</label><div class="srcpills" id="srcPills"></div><div class="mtip" id="srcTip" style="font-size:11px;color:rgba(255,255,255,.35);margin-top:6px">可在代码 SOURCES 数组扩展更多音源</div></div>
    <div class="mfield"><label>音源接口地址（HTTP，可修改）</label><div class="mtip" style="font-size:11px;color:rgba(255,255,255,.35);margin:0 0 8px">留空则用默认地址；占位符 {mid}{br}{quality} 自动替换；解析可配多接口，谁先成功用谁。字段：method/params/headers/body/extract</div>
      <div class="srcgrp"><div class="srcgrph"><span class="srcgrpi">🎵</span><span>QQ 音乐音源</span></div>
        <div class="srcrow"><span class="srcrowl">搜索</span><input id="cfgQqSearch" placeholder="https://u.y.qq.com/cgi-bin/musicu.fcg" autocomplete="off"></div>
        <div class="srcrow" style="display:block"><span class="srcrowl" style="display:block;padding:0 0 6px">解析接口</span>
          <div id="qqApiList" class="apilist"></div>
          <button type="button" id="qqApiAdd" class="apiaddbtn">＋ 添加接口</button>
          <div id="qqApiForm" class="apiform" style="display:none">
            <div class="srcrow"><span class="srcrowl">选择</span><select id="qqApiPreset"></select></div>
            <div class="srcrow"><span class="srcrowl">名称</span><input id="qqApiName" placeholder="我的接口" autocomplete="off"></div>
            <div class="srcrow"><span class="srcrowl">地址</span><input id="qqApiUrl" placeholder="https://x.com/api?mid={mid}&quality={quality}" autocomplete="off"></div>
            <div class="srcrow"><span class="srcrowl">Key</span><input id="qqApiKey" type="password" placeholder="可留空，自动加 Authorization: Bearer" autocomplete="off"></div>
            <div class="srcrow"><span class="srcrowl">提取</span><input id="qqApiExtract" placeholder="data.url（可留空自动识别）" autocomplete="off"></div>
            <div class="apibtns"><button type="button" id="qqApiCancel" class="apibtn ghost">取消</button><button type="button" id="qqApiOk" class="apibtn">确定添加</button></div>
          </div>
        </div>
      </div>
      <div class="srcgrp"><div class="srcgrph"><span class="srcgrpi">☁️</span><span>网易云音乐音源</span></div>
        <div class="srcrow"><span class="srcrowl">API</span><input id="cfgNeteaseApi" placeholder="http://139.9.223.233:3000" autocomplete="off"></div>
      </div>
      <div class="srcgrp"><div class="srcgrph"><span class="srcgrpi">🧩</span><span>自定义音源（脚本）</span></div>
        <div class="mtip" style="font-size:11px;color:rgba(255,255,255,.35);margin:0 0 8px">导入第三方音源脚本，优先解析直链，失败回落默认音源。脚本定义 async function resolve(ctx) 或 module.exports，返回 URL 字符串或 {url}</div>
        <div id="customSrcList" class="apilist"></div>
        <button type="button" id="customSrcAdd" class="apiaddbtn">＋ 添加音源</button>
        <div id="customSrcForm" class="apiform" style="display:none">
          <div class="srcrow"><span class="srcrowl">名称</span><input id="customSrcName" placeholder="我的音源（可留空）" autocomplete="off"></div>
          <div class="srcrow" style="display:block"><span class="srcrowl" style="display:block;padding:0 0 6px">脚本</span><textarea id="customSrcScript" placeholder="async function resolve(ctx){ return 'https://...' }" style="width:100%;height:110px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:10px 12px;color:#fff;font-size:12px;outline:none;resize:vertical;font-family:monospace"></textarea></div>
          <div class="srcrow"><span class="srcrowl">路径</span><input id="customSrcPath" placeholder="/sdcard/音源脚本.js" autocomplete="off" style="flex:1;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:6px 10px;color:#fff;font-size:12px;outline:none;margin-right:6px"><button type="button" id="customSrcPathBtn" class="apibtn ghost" style="padding:6px 12px">📂 读取</button></div>
          <div class="apibtns"><button type="button" id="customSrcCancel" class="apibtn ghost">取消</button><button type="button" id="customSrcOk" class="apibtn">确定添加</button></div>
        </div>
      </div>
    </div>
    <button class="msave" id="cfgSave">保存配置</button>
    <div class="mstatus" id="cfgStatus"></div>
    <button class="mclear" id="cfgClear">清除聊天记忆</button>
    <div class="mfield" style="border-top:1px solid rgba(255,255,255,.08);margin-top:16px;padding-top:16px">
      <label>原生一起听（登录 · 协议接入）</label>
      <div class="mtip" style="font-size:11px;color:rgba(255,255,255,.35);margin:0 0 10px">导入网易云 cookie 后可用原生协议与真人 / AI 同房。凭据仅本地 0600 落盘（credentials/），界面只做脱敏回显。</div>
      <div class="srcgrp"><div class="srcgrph"><span class="srcgrpi">🤖</span><span>AI 身份（solo_ai / duo 需要）</span></div>
        <div class="srcrow"><span class="srcrowl">Cookie</span><input id="nkAiCookie" type="password" placeholder="MUSIC_U=...; __csrf=...; os=pc" autocomplete="off"></div>
        <div class="srcrow"><span class="srcrowl">状态</span><span id="nkAiStatus" class="mtip" style="font-size:11px;color:rgba(255,255,255,.45);flex:1">未设置</span></div>
        <div class="apibtns" style="margin-top:6px"><button type="button" id="nkAiQr" class="apibtn">📱 扫码登录（AI 身份）</button><button type="button" id="nkAiSms" class="apibtn ghost">💬 短信登录（AI 身份）</button></div>
      </div>
      <div class="srcgrp"><div class="srcgrph"><span class="srcgrpi">🧑</span><span>真人身份（duo 需要）</span></div>
        <div class="srcrow"><span class="srcrowl">Cookie</span><input id="nkHumanCookie" type="password" placeholder="粘贴真人账号 cookie" autocomplete="off"></div>
        <div class="srcrow"><span class="srcrowl">状态</span><span id="nkHumanStatus" class="mtip" style="font-size:11px;color:rgba(255,255,255,.45);flex:1">未设置</span></div>
        <div class="apibtns" style="margin-top:6px"><button type="button" id="nkHumanQr" class="apibtn">📱 扫码登录（真人身份）</button><button type="button" id="nkHumanSms" class="apibtn ghost">💬 短信登录（真人身份）</button></div>
      </div>
      <div class="srcrow"><span class="srcrowl">接入模式</span><div class="srcpills" id="nkModePills" style="flex:1"></div></div>
      <div class="apibtns"><button type="button" id="nkClear" class="apibtn ghost">清除全部凭据</button><button type="button" id="nkSave" class="apibtn">保存并连接</button></div>
      <div class="mtip" id="nkStatus" style="font-size:11px;color:rgba(255,255,255,.45);margin-top:8px"></div>
    </div>
  </div>
</div>
<div id="qrmask"></div>
<div id="qrpanel">
  <div id="qrhead"><span id="qrtitle">扫码登录</span><span id="qrclose">关闭</span></div>
  <div id="qrtabs"><div class="qrtab on" id="qtabQr">扫码登录</div><div class="qrtab" id="qtabSms">短信验证码</div></div>
  <div id="qrbody">
    <div id="qrpaneQr">
      <div style="font-size:12px;color:rgba(255,255,255,.5);line-height:1.6">用<b>网易云音乐 App</b> 扫描下方二维码，<br>在手机上确认登录即可自动写入 cookie。</div>
      <div id="qrbox"><span id="qrspin">正在生成二维码…</span></div>
      <div id="qrstatus">请稍候…</div>
      <div class="apibtns" style="margin-top:12px"><button type="button" id="qrrefresh" class="apibtn ghost">刷新二维码</button><button type="button" id="qrdone" class="apibtn" style="display:none">完成</button></div>
    </div>
    <div id="qrpaneSms" style="display:none">
      <div style="font-size:12px;color:rgba(255,255,255,.5);line-height:1.6;margin-bottom:12px">用手机号接收短信验证码登录。<b>注意</b>：会顶掉该账号其它在线会话（与网易单点登录互斥）。</div>
      <div class="mfield"><label>手机号</label><input id="smsPhone" type="tel" inputmode="numeric" maxlength="11" placeholder="11 位大陆手机号" autocomplete="off"></div>
      <div class="mfield"><label>验证码</label>
        <div style="display:flex;gap:8px">
          <input id="smsCode" type="tel" inputmode="numeric" maxlength="8" placeholder="短信验证码" autocomplete="off" style="flex:1">
          <button type="button" id="smsSend" class="apibtn" style="flex-shrink:0;padding:0 14px;white-space:nowrap">获取验证码</button>
        </div>
      </div>
      <div class="apibtns" style="margin-top:12px"><button type="button" id="smsLogin" class="apibtn" style="flex:1">登录</button></div>
      <div id="smsStatus"></div>
    </div>
  </div>
</div>
<div id="chatpage">
  <div id="cvbg"></div>
  <div id="cvtop">
    <div id="cavs"><div class="cav me" id="cvme">🌙</div><div class="cav by" id="cvby">🌸</div></div>
    <div id="cvsub"></div>
  </div>
  <div id="cvinfo">
    <div id="cvmeta">
      <div id="cvline"><div id="cvname">还没有歌曲</div><i class="cvip" id="cvvip" style="display:none">VIP</i></div>
      <div id="cvartist"></div>
    </div>
    <div id="cvright"><div id="cvmore"><svg viewBox="0 0 24 24"><path d="M3 6h13v2H3zm0 5h13v2H3zm0 5h9v2H3zm15.5-5.8l4.5 3.3-4.5 3.3z"/></svg></div></div>
  </div>
  <div id="msgs"></div>
  <div id="inputrow">
    <div id="inputwrap"><input id="msginput" placeholder="说点什么..." maxlength="120" autocomplete="off"></div>
    <button id="sendbtn" title="发送"><svg viewBox="0 0 24 24"><path d="M3.4 20.4l17.4-8.4L3.4 3.6l.02 6.4L15 12 3.42 14z"/></svg></button>
  </div>
</div>
<div id="bottombar" class="fadeU">
    <div id="modetabs">
      <div class="mtab on" id="tabMusic"><svg viewBox="0 0 24 24"><path d="M9 19.2a2.8 2.8 0 1 1-1.9-2.65V6.3a1 1 0 0 1 .76-.97l9-2.25A1 1 0 0 1 18.1 4v11.2a2.8 2.8 0 1 1-1.9-2.65V7.28l-7 1.75z"/></svg></div>
      <div class="mtab" id="tabChat"><svg viewBox="0 0 24 24"><path d="M12 3.6c4.97 0 9 3.36 9 7.5 0 4.14-4.03 7.5-9 7.5-.86 0-1.7-.1-2.48-.29l-4.32 1.79a.5.5 0 0 1-.68-.58l.98-3.6C3.95 15.03 3 13.15 3 11.1c0-4.14 4.03-7.5 9-7.5z"/></svg><span class="badge" id="tabbadge"></span></div>
    </div>
    <div class="tbtn" id="bmore"><svg viewBox="0 0 24 24"><path d="M12 8a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z"/></svg></div>
  </div>
<div id="taphint">▶ 轻点继续播放</div>
<div id="fxlayer"></div>
<div id="searchpanel">
  <div id="sphead">
    <div id="spback"><svg viewBox="0 0 24 24"><path d="M15.4 19.4L8 12l7.4-7.4 1.4 1.4L10.8 12l6 6z"/></svg></div>
    <input id="spinput" placeholder="搜索歌曲、歌手…">
    <button id="spgo">搜索</button>
  </div>
  <div id="sptabs"><div class="sptab active" data-src="netease">网易云</div><div class="sptab" data-src="qq">QQ音乐</div></div>
  <div id="spresults"><div class="spempty">搜一首想听的歌吧 🎵</div></div>
</div>
<div id="toast"></div>
<div id="dressMask"></div>
<div id="dressPanel">
  <div id="dressHead"><div id="dressTitle">✨ 装扮库</div><div id="dressClose">✕</div></div>
  <div id="dressTabs"></div>
  <div id="dressBody"></div>
</div>
<script src="/vendor/lottie.min.js"></script>
<script src="/vendor/qrcode.js"></script>
