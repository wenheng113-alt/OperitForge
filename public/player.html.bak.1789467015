};
var DRESS_TABS=['vinyl','bgtheme','fx'];
var DRESS_LABELS={'vinyl':'唱片盘片','bgtheme':'背景主题','fx':'特效'};
var UPLOAD_HINT={'vinyl':'上传唱片盘片图片','bgtheme':'上传背景图片'};
var UPLOAD_ACCEPT={'vinyl':'image/*','bgtheme':'image/*'};

/* 自定义装扮存在 localStorage */
function getCustomDress(){
  try{return JSON.parse(localStorage.getItem('lt_custom_dress')||'{"vinyl":[],"avatar":[],"bgtheme":[]}')}catch(e){return{vinyl:[],avatar:[],bgtheme:[]}}
}
function saveCustomDress(d){localStorage.setItem('lt_custom_dress',JSON.stringify(d))}

/* 装扮状态 */
var dressState={vinyl:'',bgtheme:'',fxChat:true};
try{var saved=JSON.parse(localStorage.getItem('lt_dress')||'{}');if(saved)dressState=Object.assign(dressState,saved)}catch(e){}
var dressCurTab='vinyl';

var originalDiskSrc='/vendor/disk.png';
var originalBgFilter='blur(55px) brightness(.42) saturate(1.15)';

function applyDress(){
  document.body.setAttribute('data-vinyl',dressState.vinyl||'');
  document.body.setAttribute('data-bgtheme',dressState.bgtheme||'');
  /* 唱片盘片 */
  var diskImg=document.querySelector('.diskimg');
  if(diskImg){
    var pre=DRESS_PRESETS.vinyl.find(function(v){return v.id===dressState.vinyl});
    if(pre&&pre.svg){diskImg.src=pre.svg;}
    else{
      var customs=getCustomDress();
      var cu=customs.vinyl.find(function(v){return v.id===dressState.vinyl});
      if(cu){diskImg.src=cu.data;}
      else{diskImg.src=originalDiskSrc;}
    }
  }
  /* 背景 */
  var bg=document.getElementById('bg');
  var cvbg=document.getElementById('cvbg');
  var isCustomBg=dressState.bgtheme&&dressState.bgtheme.indexOf('cu_')===0;
  var wasCustomBg=window._customBgActive;
  window._customBgActive=false;
  if(isCustomBg){
    var customs=getCustomDress();
    var cu=customs.bgtheme.find(function(v){return v.id===dressState.bgtheme});
    if(cu){
      var blur=dressState.bgBlur!==undefined?dressState.bgBlur:0;
      var bright=dressState.bgBright!==undefined?dressState.bgBright:1;
      document.body.setAttribute('data-bgtheme','custom');
      bg.style.backgroundImage='url('+cu.data+')';
      bg.style.filter='blur('+blur+'px) brightness('+bright+')';
      if(cvbg){cvbg.style.backgroundImage='url('+cu.data+')';cvbg.style.filter='blur('+blur+'px) brightness('+bright+')';}
      window._customBgActive=true;
    }
  }else if(wasCustomBg){
    /* 只有从自定义背景切回默认时才恢复歌曲封面背景 */
    bg.style.backgroundImage='';
    bg.style.filter=originalBgFilter;
    if(cvbg){cvbg.style.backgroundImage='';cvbg.style.filter=originalBgFilter;}
    /* 重新用当前歌曲封面恢复背景 */
    if(S.song&&S.song.pic){swapBg(bg,S.song.pic);if(cvbg)cvbg.style.backgroundImage='url("'+S.song.pic+'")'}
  }
}
function openDressPanel(){
  var m=document.getElementById('dressMask');
  var p=document.getElementById('dressPanel');
  if(!m||!p)return;
  m.classList.add('show');p.classList.add('show');
  buildDressUI();
}
function closeDressPanel(){
  document.getElementById('dressMask').classList.remove('show');
  document.getElementById('dressPanel').classList.remove('show');
}
/* 图片压缩为base64，限制大小 */
function compressImage(file,cb,maxW,maxH,maxKB,keepAlpha){
  var reader=new FileReader();
  reader.onload=function(e){
    var img=new Image();
    img.onload=function(){
      var canvas=document.createElement('canvas');
      var w=img.width,h=img.height;
      var scale=Math.min(maxW/w,maxH/h,1);
      w=Math.round(w*scale);h=Math.round(h*scale);
      canvas.width=w;canvas.height=h;
      var ctx=canvas.getContext('2d');
      ctx.drawImage(img,0,0,w,h);
      if(keepAlpha){
        var data=canvas.toDataURL('image/png');
        while(data.length>maxKB*1024*1.37&&w>100){w=Math.round(w*0.8);h=Math.round(h*0.8);canvas.width=w;canvas.height=h;ctx.drawImage(img,0,0,w,h);data=canvas.toDataURL('image/png');}
        cb(data);
      }else{
        var quality=0.85;
        var data=canvas.toDataURL('image/jpeg',quality);
        while(data.length>maxKB*1024*1.37&&quality>0.3){quality-=0.15;data=canvas.toDataURL('image/jpeg',quality);}
        cb(data);
      }
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}
function handleDressUpload(file){
  if(!file||!file.type.startsWith('image/')){toast('请选择图片文件');return;}
  var tab=dressCurTab;
  if(tab==='fx'){toast('粒子特效不支持上传');return;}
  var maxW=tab==='bgtheme'?1920:300,maxH=tab==='bgtheme'?1080:300,maxKB=tab==='bgtheme'?500:200;
  var keepAlpha=tab==='avatar';
  compressImage(file,function(data){
    var customs=getCustomDress();
    if(!customs[tab])customs[tab]=[];
    var id='cu_'+Date.now();
    customs[tab].push({id:id,name:'自定义 #'+(customs[tab].length+1),data:data,ts:Date.now()});
    saveCustomDress(customs);
    dressState[tab]=id;
    localStorage.setItem('lt_dress',JSON.stringify(dressState));
    applyDress();
    buildDressUI();
    toast('上传成功~');
  },maxW,maxH,maxKB,keepAlpha);
}
function deleteCustomDress(tab,id){
  var customs=getCustomDress();
  customs[tab]=customs[tab].filter(function(v){return v.id!==id});
  saveCustomDress(customs);
  if(dressState[tab]===id){dressState[tab]='';localStorage.setItem('lt_dress',JSON.stringify(dressState));applyDress();}
  buildDressUI();
  toast('已删除');
}
function buildDressUI(){
  var tabsEl=document.getElementById('dressTabs');
  var bodyEl=document.getElementById('dressBody');
  if(!tabsEl||!bodyEl)return;
  tabsEl.innerHTML='';
  DRESS_TABS.forEach(function(tab){
    var t=document.createElement('div');
    t.className='dressTab'+(tab===dressCurTab?' active':'');
    t.textContent=DRESS_LABELS[tab];
    t.onclick=function(){dressCurTab=tab;buildDressUI()};
    tabsEl.appendChild(t);
  });
  var html='';
  /* 预设项 */
  var presets=DRESS_PRESETS[dressCurTab]||[];
  presets.forEach(function(item){
    var active=dressState[dressCurTab]===item.id?'active':'';
    var prev=getPresetPreview(dressCurTab,item.id,item);
    html+='<div class="dressItem '+active+'" data-id="'+item.id+'"><div class="dressPreview">'+prev+'</div><div class="dressLabel">'+item.name+'</div><div class="dressCheck">✓</div></div>';
  });
  /* 自定义项 */
  var customs=getCustomDress();
  var cuList=customs[dressCurTab]||[];
  cuList.forEach(function(item){
    var active=dressState[dressCurTab]===item.id?'active':'';
    var prev='<img src="'+item.data+'" style="width:100%;height:100%;object-fit:cover;border-radius:8px">';
    html+='<div class="dressCustomItem '+active+'" data-id="'+item.id+'"><div class="dressPreview" style="width:100%;height:100%">'+prev+'</div><div class="dressLabel">'+item.name+'</div><div class="dressDelBtn" data-del="'+item.id+'">✕</div><div class="dressCheck">✓</div></div>';
  });
  /* 上传按钮 */
  if(dressCurTab!=='fx'){html+='<div class="dressUploadBtn" id="dressUploadBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>'+UPLOAD_HINT[dressCurTab]+'</div>';}
  if(dressCurTab==='fx'){var fxOn=dressState.fxChat!==false;bodyEl.innerHTML='<div class="fxRow"><div class="fxLabel">聊天特效（粒子 + 音效）</div><div class="fxSwitch'+(fxOn?' on':'')+'" id="fxToggle"><i></i></div></div><div class="fxHint">开启后好友回复时会飘落爱心/星光粒子并伴提示音；关闭可让聊天完全静音、更清爽也更省电。</div>';var tg=bodyEl.querySelector('#fxToggle');if(tg)tg.onclick=function(){dressState.fxChat=!(dressState.fxChat!==false);localStorage.setItem('lt_dress',JSON.stringify(dressState));buildDressUI();toast(dressState.fxChat?'聊天特效已开启 ✨':'聊天特效已关闭（粒子+音效）🍃');};return;}
  bodyEl.innerHTML='<div class="dressGrid">'+html+'</div>';
  /* 背景模糊调节器 - 选了自定义背景时在grid外面显示 */
  var blurHTML='';
  if(dressCurTab==='bgtheme'&&typeof dressState.bgtheme==='string'&&dressState.bgtheme.indexOf('cu_')===0){
    var blur=dressState.bgBlur!==undefined?dressState.bgBlur:0;
    var bright=dressState.bgBright!==undefined?dressState.bgBright:1;
    blurHTML='<div class="dressBlurBar"><label>模糊度 <span id="blurVal">'+blur+'px</span></label><input type="range" id="bgBlurSlider" min="0" max="80" value="'+blur+'"><label>亮度 <span id="brightVal">'+bright.toFixed(2)+'</span></label><input type="range" id="bgBrightSlider" min="0.3" max="1.5" step="0.05" value="'+bright+'"></div>';
  }
  if(blurHTML){bodyEl.insertAdjacentHTML('beforeend',blurHTML);}
  /* 绑定点击 */
  bodyEl.querySelectorAll('.dressItem,.dressCustomItem').forEach(function(el){
    el.onclick=function(e){
      if(e.target.classList.contains('dressDelBtn'))return;
      var id=el.getAttribute('data-id');
      dressState[dressCurTab]=id;
      localStorage.setItem('lt_dress',JSON.stringify(dressState));
      applyDress();
      buildDressUI();
    };
  });
  bodyEl.querySelectorAll('.dressDelBtn').forEach(function(el){
    el.onclick=function(e){
      e.stopPropagation();
      deleteCustomDress(dressCurTab,el.getAttribute('data-del'));
    };
  });
  /* 上传按钮 */
  var ub=bodyEl.querySelector('#dressUploadBtn');
  if(ub){
    ub.onclick=function(){
      var input=document.createElement('input');
      input.type='file';
      input.accept=UPLOAD_ACCEPT[dressCurTab]||'image/*';
      input.onchange=function(){
        if(input.files&&input.files[0])handleDressUpload(input.files[0]);
      };
      input.click();
    };
  }
  /* 模糊/亮度滑块 */
  var blurSlider=bodyEl.querySelector('#bgBlurSlider');
  var brightSlider=bodyEl.querySelector('#bgBrightSlider');
  if(blurSlider){
    blurSlider.oninput=function(){
      var v=parseInt(this.value);
      dressState.bgBlur=v;
      localStorage.setItem('lt_dress',JSON.stringify(dressState));
      applyDress();
      var el=document.getElementById('blurVal');
      if(el)el.textContent=v+'px';
    };
  }
  if(brightSlider){
    brightSlider.oninput=function(){
      var v=parseFloat(this.value);
      dressState.bgBright=v;
      localStorage.setItem('lt_dress',JSON.stringify(dressState));
      applyDress();
      var el=document.getElementById('brightVal');
      if(el)el.textContent=v.toFixed(2);
    };
  }
}
function getPresetPreview(tab,id,item){
  if(tab==='vinyl'){
    if(item&&item.svg)return '<img src="'+item.svg+'" style="width:80%;height:80%;border-radius:50%">';
    var glows={'glow1':'rgba(255,180,80,.5)','glow2':'rgba(80,180,255,.5)','glow3':'rgba(255,100,150,.5)','glow4':'rgba(180,100,255,.5)','glow5':'rgba(255,255,255,.4)'};
    if(glows[id])return '<svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="98" fill="#1a1a1a"/><circle cx="100" cy="100" r="30" fill="#222"/><circle cx="100" cy="100" r="4" fill="#555"/><circle cx="100" cy="100" r="98" fill="none" stroke="'+glows[id]+'" stroke-width="8"/></svg>';
    return '<svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="98" fill="#1a1a1a"/><circle cx="100" cy="100" r="30" fill="#222"/><circle cx="100" cy="100" r="4" fill="#555"/></svg>';
  }
  if(tab==='bgtheme'){
    var bgs={'':'#15151c','bg1':'#1a1a2e','bg2':'#2d1b3d','bg3':'#1b3d2e','bg4':'#3d1b1b','bg5':'#1b2d3d'};
    return '<svg viewBox="0 0 200 200"><rect width="200" height="200" rx="12" fill="'+(bgs[id]||'#15151c')+'"/></svg>';
  }
  return '';
}
(function(){
  window.__csRender=function(){
    var el=$('customSrcList');if(!el)return;
    fetch('/source/list').then(function(r){return r.json()}).then(function(d){
      var arr=(d&&d.sources)||[];
      if(!arr.length){el.innerHTML='<div class="apiempty">\u8fd8\u6ca1\u6709\u81ea\u5b9a\u4e49\u97f3\u6e90</div>';return}
      el.innerHTML=arr.map(function(s){
        var on=s.enabled!==false;
        return '<div class="apiitem" data-id="'+s.id+'"><span class="apinm">'+((s.name||s.id))+ '</span>'
          +'<span class="apiurl">'+(s.len||0)+' \u5b57\u7b26</span>'
          +'<span class="apikey" data-act="toggle" style="cursor:pointer;'+(on?'':'opacity:.45;color:rgba(255,255,255,.45);border-color:rgba(255,255,255,.3)')+'">'+(on?'\u542f\u7528':'\u505c\u7528')+'</span>'
          +'<span class="apidel" data-act="del">\u2715</span></div>';
      }).join('');
    }).catch(function(){el.innerHTML='<div class="apiempty">\u52a0\u8f7d\u5931\u8d25</div>'});
  };
  var f=$('customSrcForm');
  $('customSrcAdd').onclick=function(){f.style.display=(f.style.display==='none'?'block':'none')};
  $('customSrcCancel').onclick=function(){f.style.display='none'};
  var pathBtn=$('customSrcPathBtn'), pathInp=$('customSrcPath');
  if(pathBtn&&pathInp){
    pathBtn.onclick=function(){
      var p=(pathInp.value||'').replace(/^\s+|\s+$/g,'');
      if(!p){toast('请填写文件路径，如 /sdcard/x.js');return}
      pathBtn.disabled=true;pathBtn.textContent='\u8bfb\u53d6\u4e2d...';
      fetch('/source/readfile?path='+encodeURIComponent(p)).then(function(r){return r.json()}).then(function(d){
        pathBtn.disabled=false;pathBtn.textContent='\ud83d\udcc2 \u8bfb\u53d6';
        if(d&&d.ok){
          $('customSrcScript').value=d.content;
          if(!$('customSrcName').value.replace(/\s/g,'')){$('customSrcName').value=d.name||''}
          toast('\u5df2\u8bfb\u5165\uff1a'+(d.name||p));
        } else { toast('\u8bfb\u53d6\u5931\u8d25\uff1a'+((d&&d.error)||'')); }
      }).catch(function(){pathBtn.disabled=false;pathBtn.textContent='\ud83d\udcc2 \u8bfb\u53d6';toast('\u8bfb\u53d6\u5931\u8d25')});
    };
  }
  $('customSrcOk').onclick=function(){
    var nm=$('customSrcName').value.replace(/^\s+|\s+$/g,'');
    var sc=$('customSrcScript').value;
    if(!sc.replace(/\s/g,'')){toast('\u8bf7\u7c98\u8d34\u97f3\u6e90\u811a\u672c');return}
    fetch('/source/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:nm,script:sc})})
      .then(function(r){return r.json()}).then(function(d){
        if(d&&d.ok){toast('\u97f3\u6e90\u5df2\u6dfb\u52a0');f.style.display='none';$('customSrcName').value='';$('customSrcScript').value='';window.__csRender()}
        else{toast('\u6dfb\u52a0\u5931\u8d25\uff1a'+((d&&d.error)||''))}
      }).catch(function(){toast('\u6dfb\u52a0\u5931\u8d25')});
  };
  $('customSrcList').onclick=function(e){
    var t=e.target;if(!t||!t.getAttribute)return;
    var act=t.getAttribute('data-act');if(!act)return;
    var id=t.parentNode.getAttribute('data-id');if(!id)return;
    if(act==='del'){
      if(!window.confirm('\u786e\u5b9a\u5220\u9664\u8be5\u97f3\u6e90\uff1f'))return;
      fetch('/source/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})})
        .then(function(r){return r.json()}).then(function(d){if(d&&d.ok){toast('\u5df2\u5220\u9664');window.__csRender()}else toast('\u5220\u9664\u5931\u8d25')});
    }else if(act==='toggle'){
      var on=(t.textContent==='\u542f\u7528');
      fetch('/source/toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,enabled:!on})})
        .then(function(r){return r.json()}).then(function(d){window.__csRender()});
    }
  };
  window.__csRender();
})();
bindQqApiUI();
document.getElementById('dressClose').onclick=closeDressPanel;
document.getElementById('dressMask').onclick=closeDressPanel;
applyDress();
fetch('/ai/config').then(function(r){return r.json()}).then(function(d){if(d&&d.soundSource)applySource(d.soundSource)}).catch(function(){});
 </script>
</body>
</html>