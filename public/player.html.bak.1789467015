  try{console.log("[LS]"+((song&&song.name)||"?")+" fresh="+(_mslid>0&&(Date.now()-_mslid)<900)+" since_ms="+(Date.now()-(_mslid||0)))}catch(e){} /* 同曲同源重复事件去抖: 防连发事件二次重置旋转 */
