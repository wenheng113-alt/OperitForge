function ensurePlay(){if(window.__micHold)return;startBgKeepAlive();var p=audio.play();if(p&&p.catch)p.catch(function(){})}

/* ═══ 后台播放: Media Session + Wake Lock + 进度同步 ═══ */
var _wakeLock=null;
function acquireWakeLock(){
 if(_wakeLock)return;
 try{
  if(navigator.wakeLock&&navigator.wakeLock.request){
   navigator.wakeLock.request('screen').then(function(wl){_wakeLock=wl;wl.addEventListener('release',function(){_wakeLock=null})}).catch(function(){});
  }
 }catch(e){}
}
function releaseWakeLock(){
 if(_wakeLock){try{_wakeLock.release()}catch(e){}_wakeLock=null}
}
function updateMediaMeta(song){
 try{
  if(!('mediaSession'in navigator))return;
  navigator.mediaSession.metadata=new MediaMetadata({
   title:song.name||'一起听',
   artist:song.artist||'',
   album:song.album||'',
   artwork:[{src:song.pic||'',sizes:'512x512',type:'image/jpeg'}]
  });
 }catch(e){}
}
function updateMediaSession(playing){
 try{
  if(!('mediaSession'in navigator))return;
  navigator.mediaSession.playbackState=playing?'playing':'paused';
 }catch(e){}
}
/* Media Session 通知栏控制 */
try{
 navigator.mediaSession.setActionHandler('play',function(){pushControl({action:'toggle'})});
 navigator.mediaSession.setActionHandler('pause',function(){pushControl({action:'toggle'})});
 navigator.mediaSession.setActionHandler('nexttrack',function(){pushControl({action:'next'})});
 navigator.mediaSession.setActionHandler('previoustrack',function(){pushControl({action:'prev'})});
 navigator.mediaSession.setActionHandler('seekto',function(d){if(d&&d.seekTime!=null){var ms=Math.round(d.seekTime*1000);seekTo(ms/((audio.duration||(S.song&&S.song.duration/1000)||0)*1000))}});
}catch(e){}
/* 被动暂停检测: 无论 document.hidden 是否为 true, 只要服务端状态是 playing 就尝试恢复 */
var _shouldPlay=false; /* 独立播放标志, 不受 SSE 断连影响 */
audio.addEventListener('play',function(){_shouldPlay=true;acquireWakeLock()});
audio.addEventListener('pause',function(e){
 /* 诊断: 上报 pause 事件时的状态 */
 try{fetch('/debug',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
  event:'audio_pause',
  hidden:document.hidden,
  Splaying:S.playing,
  shouldPlay:_shouldPlay,
