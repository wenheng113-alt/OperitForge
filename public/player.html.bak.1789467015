fetch('/state').then(function(r){return r.json()}).then(function(st){applySync(st)}).catch(function(){});
refreshMsgs();
connect();
/* ── 点击距离文字自定义: 相距公里数 / 一起听小时数(存服务端, 重启不丢) ── */
(function(){
  function renderMeta(m){
    if(!m)return;
    if(typeof m.distanceKm==='string')DISTANCE_KM=m.distanceKm;
    if(typeof m.listenSeconds==='number')LISTEN_SECONDS=m.listenSeconds;
    setDistTxt();
  }
renderMeta({distanceKm:DISTANCE_KM,listenSeconds:LISTEN_SECONDS});
  var dlg=document.createElement('div');
  dlg.style.cssText='position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.55);z-index:80;display:none;-webkit-align-items:center;align-items:center;-webkit-justify-content:center;justify-content:center';
  dlg.innerHTML='<div style="background:#262129;border-radius:14px;padding:18px 16px;width:250px;font-size:13px;color:#fff">'
   +'<div style="text-align:center;margin-bottom:12px">自定义展示</div>'
   +'<div style="opacity:.6;margin-bottom:4px">相距（公里）</div>'
   +'<input id="dlg_km" type="text" inputmode="decimal" maxlength="8" style="width:100%;box-sizing:border-box;background:#17131a;border:none;outline:none;color:#fff;border-radius:8px;padding:9px 10px;margin-bottom:10px">'
   +'<div style="opacity:.6;margin-bottom:4px">一起听了（小时，留空则自动累计）</div>'
   +'<input id="dlg_hr" type="number" inputmode="decimal" step="0.1" min="0" style="width:100%;box-sizing:border-box;background:#17131a;border:none;outline:none;color:#fff;border-radius:8px;padding:9px 10px;margin-bottom:14px">'
   +'<div style="display:-webkit-flex;display:flex;gap:10px"><button id="dlg_cancel" style="-webkit-flex:1;flex:1;background:#3a3340;color:#ddd;border:none;border-radius:9px;padding:9px 0">取消</button>'
   +'<button id="dlg_ok" style="-webkit-flex:1;flex:1;background:#e0484f;color:#fff;border:none;border-radius:9px;padding:9px 0">保存</button></div></div>';
  document.body.appendChild(dlg);
  $('distance').addEventListener('click',function(){
    $('dlg_km').value=DISTANCE_KM;
    $('dlg_hr').value='';
    $('dlg_hr').placeholder=(LISTEN_SECONDS/3600).toFixed(1);
    dlg.style.display='-webkit-flex';dlg.style.display='flex';
    setTimeout(function(){try{$('dlg_km').focus()}catch(e){}},150);
  });
  $('dlg_cancel').addEventListener('click',function(){dlg.style.display='none'});
  dlg.addEventListener('click',function(e){if(e.target===dlg)dlg.style.display='none'});
  $('dlg_ok').addEventListener('click',function(){
    var km=$('dlg_km').value.trim(),hrInput=$('dlg_hr').value.trim();
    if(!km){toast('距离不能为空呀');return}
    DISTANCE_KM=km;
    /* 听歌时长: 留空则不修改(自动累计), 填了则校准 */
    var meta={distanceKm:km};
    if(hrInput!==''){
      var hr=parseFloat(hrInput);
      if(!isFinite(hr)||hr<0||hr>99999){toast('小时数要在0～99999之间');return}
      LISTEN_SECONDS=Math.round(hr*3600);
      meta.listenSeconds=LISTEN_SECONDS;
    }
    var hrs=(LISTEN_SECONDS/3600).toFixed(1);
    $('distance').textContent='相距 '+km+'公里，一起听了'+hrs+'小时';
    api('/control',{action:'setmeta',meta:meta,clientId:clientId,name:'用户'});
    dlg.style.display='none';toast('已保存～');
  });
})();
/* ════ 装扮库系统 - 预设+自定义上传 ════ */
function makeDiscSVG(opts){
  var bg=opts.bg||'#1a1a1a',ring=opts.ring||'#333',center=opts.center||'#555';
  var labelBg=opts.labelBg||'#222',labelRing=opts.labelRing||'#444';
  var grooveColor=opts.groove||'rgba(255,255,255,0.04)',highlight=opts.highlight||'';
  var svg='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200"><defs><radialGradient id="dg" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="'+center+'"/><stop offset="25%" stop-color="'+labelBg+'"/><stop offset="26%" stop-color="'+labelRing+'"/><stop offset="28%" stop-color="'+bg+'"/><stop offset="100%" stop-color="'+ring+'"/></radialGradient>';
  if(highlight){svg+='<radialGradient id="hl" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="'+highlight+'" stop-opacity="0.3"/><stop offset="50%" stop-color="'+highlight+'" stop-opacity="0.1"/><stop offset="100%" stop-color="'+highlight+'" stop-opacity="0"/></radialGradient>';}
  svg+='</defs><circle cx="100" cy="100" r="98" fill="url(#dg)"/>';
  for(var r=35;r<98;r+=3){svg+='<circle cx="100" cy="100" r="'+r+'" fill="none" stroke="'+grooveColor+'" stroke-width="0.5"/>';}
  svg+='<circle cx="100" cy="100" r="30" fill="'+labelBg+'" stroke="'+labelRing+'" stroke-width="1"/><circle cx="100" cy="100" r="4" fill="'+center+'"/><circle cx="100" cy="100" r="2" fill="#1a1a1a"/>';
  if(highlight){svg+='<circle cx="100" cy="100" r="98" fill="url(#hl)"/>';}
  svg+='</svg>';
  return 'data:image/svg+xml,'+encodeURIComponent(svg);
}

