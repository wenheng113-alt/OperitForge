});
 function swapBg(el,url){ /* 背景交叉淡化: 新图临时层淡入覆盖旧图, 落定后撤层 */
  try{
   if(!el)return;
   if(el._bsw&&el._bsw.parentNode){el.style.backgroundImage=el._bsw._u||el.style.backgroundImage;el._bsw.parentNode.removeChild(el._bsw);el._bsw=null}
   var tgt=url?('url("'+url+'")'):'none';
   if(el.style.backgroundImage===tgt)return;
   if(!url){el.style.backgroundImage=tgt;return}
   var cs=getComputedStyle(el);
   var e=document.createElement('div');
   e.style.cssText='position:'+(cs.position==='static'?'absolute':cs.position)+';top:'+cs.top+';left:'+cs.left+';right:'+cs.right+';bottom:'+cs.bottom+';z-index:'+(cs.zIndex==='auto'?0:cs.zIndex)+';background:#2a2226 center/cover no-repeat '+tgt+';-webkit-filter:'+(cs.webkitFilter||cs.filter)+';filter:'+(cs.filter||cs.webkitFilter)+';opacity:0;transition:opacity .65s ease;-webkit-transition:opacity .65s ease;pointer-events:none';
   e._u=tgt;el._bsw=e;
   el.parentNode.insertBefore(e,el.nextSibling);
   void e.offsetWidth;
   e.style.opacity='1';
   setTimeout(function(){el.style.backgroundImage=tgt;if(e.parentNode)e.parentNode.removeChild(e);if(el._bsw===e)el._bsw=null},700);
  }catch(err){try{el.style.backgroundImage=url?('url("'+url+'")'):'none'}catch(e2){}}
 }
var curLyrics=[],curLine=-1;
